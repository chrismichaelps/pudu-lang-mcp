/** @App.Tools.Docs.Handler — documentation search and reading tools */
module App.Tools.Docs

import Std.List as List
import Std.Option as Option
import Std.Text as Text
import App.Context as Context
import Constants.Server as Server
import Domain.Catalog.Arguments as Arguments
import Domain.Docs.Chapter as Chapter
import Domain.Docs.Search as Search
import Errors.ToolError as ToolError
import Utils.TextBounds as TextBounds

/// The groups a document can belong to.
export const GROUPS: Array[Str] = ["docs", "pages", "releases", "examples"]

/// The group read when a caller names none.
const DEFAULT_GROUP: Str = "docs"

/// Characters of context shown around a search hit.
const SNIPPET_WIDTH: Int = 240

/// Answers the best-matching documentation sections for `query`.
export fn search(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  let query = Option.unwrapOr(Arguments.text(args, "query"), "")
  let group = groupOf(args) ?
  let limit = Arguments.integerOr(args, "limit", Server.DEFAULT_SEARCH_LIMIT)
  let sections = match group {
    case Some(wanted) => context.sections.filter(|held: Chapter.Section| held.group == wanted)
    case None => context.sections
  }
  let hits = Search.search(&sections, query, limit)
  if hits.isEmpty() {
    return Ok("No documentation matches '" + query + "'. Try other words, or pudu_reference_search for a library name.")
  }
  let first = Option.unwrapOr(List.first(&Search.terms(query)), query)
  var lines: Array[Str] = []
  var number = 1
  for hit in hits {
    let held = hit.section
    lines = lines.push(show(number) + ". " + held.group + "/" + held.chapter + "#" + held.anchor + " — " + held.chapterTitle + " › " + held.heading)
    lines = lines.push("   " + TextBounds.snippet(held.text, first, SNIPPET_WIDTH))
    number = number + 1
  }
  Ok(lines.join("\n") + "\n\nRead one with pudu_docs_read using its slug and, for a section, its anchor.")
}

/// Answers one document, or one of its sections.
export fn read(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  let group = Option.unwrapOr(groupOf(args) ?, DEFAULT_GROUP)
  let slug = Option.unwrapOr(Arguments.text(args, "slug"), "").trim()
  let chapter = match Chapter.find(&context.chapters, group, slug) {
    case Some(found) => found
    case None => {
      let known = Chapter.inGroup(&context.chapters, group).map(|held: Chapter.Chapter| held.slug)
      return Err(ToolError.NotFound("Document '" + group + "/" + slug + "' (" + group + " has: " + known.join(", ") + ")"))
    }
  }
  match Arguments.text(args, "section") {
    case Some(wanted) => {
      if Text.isBlank(wanted) { return Ok(TextBounds.bounded(chapter.markdown, Server.DOC_CHARS)) }
      match Chapter.sectionIn(&chapter, wanted) {
        case Some(held) => Ok(TextBounds.bounded("## " + held.heading + "\n\n" + held.text, Server.DOC_CHARS))
        case None => {
          let anchors = Chapter.sectionsOf(&chapter).map(|held: Chapter.Section| held.anchor)
          Err(ToolError.NotFound("Section '" + wanted + "' of " + group + "/" + slug + " (sections: " + anchors.join(", ") + ")"))
        }
      }
    }
    case None => Ok(TextBounds.bounded(chapter.markdown, Server.DOC_CHARS))
  }
}

/// The `group` argument, checked against the known groups.
fn groupOf(args: &Arguments.Args) -> Result[Option[Str], ToolError.ToolFailure] {
  match Arguments.text(args, "group") {
    case None => Ok(None)
    case Some(given) => {
      let wanted = given.trim()
      if wanted.isEmpty() { return Ok(None) }
      if GROUPS.contains(wanted) { Ok(Some(wanted)) } else { Err(ToolError.OutOfRange("group", "one of " + GROUPS.join(", "))) }
    }
  }
}
