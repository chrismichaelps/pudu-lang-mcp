/** @App.Completion.Handler — argument completion for templates and prompts */
module App.Completion

import Std.Json as Json
import Std.List as List
import Std.Option as Option
import App.Context as Context
import App.Resources as Resources
import Domain.Docs.Chapter as Chapter
import Domain.Rpc.Reply as Reply
import Errors.RpcError as RpcError
import Services.Reference as Reference
import Utils.JsonAccess as Access

/// The most values one completion answers, as the specification allows.
const MAX_VALUES: Int = 100

/// Answers the values that could complete one argument.
export fn complete(context: &Context.Context, params: &Json.Json) -> Result[Json.Json, RpcError.ProtocolError] {
  let reference = Option.unwrapOr(Access.member(params, "ref"), Json.Null)
  let kind = match Access.text(&reference, "type") {
    case Some(given) => given
    case None => { return Err(RpcError.InvalidParams("ref.type must be a string")) }
  }
  let argument = Option.unwrapOr(Access.member(params, "argument"), Json.Null)
  let name = match Access.text(&argument, "name") {
    case Some(given) => given
    case None => { return Err(RpcError.InvalidParams("argument.name must be a string")) }
  }
  let value = match Access.text(&argument, "value") {
    case Some(given) => given.toLower()
    case None => { return Err(RpcError.InvalidParams("argument.value must be a string")) }
  }
  let template = Resources.REFERENCE_PREFIX + "\{module\}"
  let candidates = if kind == "ref/resource" && Access.text(&reference, "uri") == Some(template) && name == "module" {
    context.moduleFiles.map(|held: Reference.ModuleFile| held.moduleName)
  } else if kind == "ref/prompt" && Access.text(&reference, "name") == Some("pudu_explain") && name == "topic" {
    Chapter.inGroup(&context.chapters, "docs").map(|held: Chapter.Chapter| held.slug)
  } else {
    []
  }
  let matching = candidates.filter(|candidate: Str| candidate.toLower().startsWith(value))
  let shown = List.take(&matching, MAX_VALUES)
  Ok(Reply.complete(&[
        ("completion", Json.object(&[
              ("values", Access.texts(&shown)),
              ("total", Json.Number(matching.length())),
              ("hasMore", Json.Boolean(matching.length() > shown.length()))
            ]))
      ], &Reply.NoCache))
}
