/** @Domain.Docs.Search.Module — ranks documentation sections for a query */
module Domain.Docs.Search

import Std.Char as Char
import Std.List as List
import Std.Math as Math
import Std.Text as Text
import Domain.Docs.Chapter as Chapter

/** @Domain.Docs.Search.Hit — a ranked documentation section */
export type Hit = { section: Chapter.Section, score: Int }

/// Words too common to rank by.
const STOP_WORDS: Set[Str] = setOf([
    "a", "an", "and", "are", "as", "at", "be", "by", "can", "do", "does", "for", "from", "how", "i", "if",
    "in", "is", "it", "me", "my", "of", "on", "or", "pudu", "should", "the", "to", "use", "what", "when",
    "where", "which", "why", "with", "write"
  ])

/// Points when the whole query appears in a heading.
const PHRASE_IN_HEADING: Int = 40
/// Points when the whole query appears in a section's text.
const PHRASE_IN_TEXT: Int = 12
/// Points per query term found in a heading.
const TERM_IN_HEADING: Int = 10
/// Points per occurrence of a term in a section's text.
const TERM_IN_TEXT: Int = 2
/// Occurrences of one term counted before they stop adding points.
const MAX_COUNTED_OCCURRENCES: Int = 5
/// Points when a section contains every term.
const EVERY_TERM: Int = 15
/// The shortest query scored as a phrase.
const MIN_PHRASE_LENGTH: Int = 3

/// The distinct search terms of a query, stop words removed.
export fn terms(query: Str) -> Array[Str] {
  var found: Array[Str] = []
  var current = ""
  for character in (query.toLower() + " ").chars() {
    if isTermCharacter(character) {
      current = current + Text.singleton(character)
    } else {
      let term = Text.dropAround(current, |c: Char| c == '.')
      if !term.isEmpty() && !STOP_WORDS.contains(term) && !found.contains(term) { found = found.push(term) }
      current = ""
    }
  }
  found
}

/// How well one section answers a query; zero when no term matches.
export fn score(section: &Chapter.Section, query: Str, words: &Array[Str]) -> Int {
  if words.isEmpty() { return 0 }
  let heading = section.heading.toLower()
  let text = section.text.toLower()
  let phrase = query.trim().toLower()
  var total = 0
  if phrase.length() >= MIN_PHRASE_LENGTH {
    if heading.contains(phrase) { total = total + PHRASE_IN_HEADING }
    if text.contains(phrase) { total = total + PHRASE_IN_TEXT }
  }
  var matched = 0
  for word in *words {
    let inHeading = heading.contains(word)
    let occurrences = Text.countOccurrences(text, word)
    if inHeading { total = total + TERM_IN_HEADING }
    let counted = Math.min(occurrences, MAX_COUNTED_OCCURRENCES)
    total = total + counted * TERM_IN_TEXT
    if inHeading || occurrences > 0 { matched = matched + 1 }
  }
  if matched == words.length() { total = total + EVERY_TERM }
  if matched == 0 { 0 } else { total }
}

/// The best-matching sections, highest score first.
export fn search(sections: &Array[Chapter.Section], query: Str, limit: Int) -> Array[Hit] {
  let words = terms(query)
  if words.isEmpty() { return [] }
  var ranked: Array[Hit] = []
  for section in *sections {
    let points = score(&section, query, &words)
    if points > 0 { ranked = ranked.push(Hit{section: section, score: points}) }
  }
  List.take(&List.sortOn(&ranked, |hit: Hit| 0 - hit.score), limit)
}

/// Whether a character belongs to a search term.
fn isTermCharacter(character: Char) -> Bool {
  Char.isAlphanumeric(character) || character == '_' || character == '.'
}
