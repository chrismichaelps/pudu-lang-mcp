/** @Domain.Catalog.Tools.Registry — every tool in listing order */
module Domain.Catalog.Tools

import Std.List as List
import Constants.Server as Server
import Domain.Catalog.ToolSpec as ToolSpec

/// Hints for tools that only read and answer the same way each time.
const LOOKUP: ToolSpec.Annotations = ToolSpec.Annotations{readOnly: true, destructive: false, idempotent: true, openWorld: false}
/// Hints for running a program confined: no effects outside it.
const CONFINED_RUN: ToolSpec.Annotations = ToolSpec.Annotations{readOnly: true, destructive: false, idempotent: false, openWorld: false}
/// Hints for running the project's tests with its full permissions.
const PROJECT_RUN: ToolSpec.Annotations = ToolSpec.Annotations{readOnly: false, destructive: false, idempotent: false, openWorld: true}

/// The argument pair of which exactly one names the code.
const SOURCE_OR_PATH: Array[Str] = ["source", "path"]

/// Every tool, in listing order.
export fn all() -> Array[ToolSpec.ToolSpec] {
  [
    spec("pudu_docs_search", "Search Pudu documentation", "Search the Pudu language guide, site pages, release notes, and example programs. Answers the best-matching sections with their address for pudu_docs_read.", [
        ToolSpec.text("query", "Words or a qualified name to look for, such as 'error handling with Result' or 'Option.unwrapOr'.", true),
        ToolSpec.text("group", "Limit the search to one group: docs, pages, releases, or examples.", false),
        ToolSpec.integer("limit", "Most sections to answer.", false, 1, Server.MAX_SEARCH_LIMIT)
      ], [], LOOKUP),
    spec("pudu_docs_read", "Read Pudu documentation", "Read one document, or one section of it, by the slug pudu_docs_search answers. With no section, answers the whole document.", [
        ToolSpec.text("slug", "The document's slug, such as 'errors' or 'ownership'.", true),
        ToolSpec.text("group", "docs (default), pages, releases, or examples.", false),
        ToolSpec.text("section", "A section heading or its anchor, such as 'working-with-results'.", false)
      ], [], LOOKUP),
    spec("pudu_reference_search", "Search the Pudu API", "Search the installed standard library and the workspace's installed packages by name, description, or type shape such as 'Array[a] -> Option[a]'.", [
        ToolSpec.text("query", "A name, words from a description, or a type shape containing '->'.", true),
        ToolSpec.integer("limit", "Most declarations to answer.", false, 1, Server.MAX_SEARCH_LIMIT)
      ], [], LOOKUP),
    spec("pudu_module_reference", "Read a module's API", "Every public declaration of one module with its signature and documentation, such as Std.Json, from the installed toolchain or an installed package.", [
        ToolSpec.text("module", "The module name, such as 'Std.Json' or 'Std.Http.Server'.", true)
      ], [], LOOKUP),
    spec("pudu_check", "Check Pudu code", "Compile Pudu code and report its diagnostics without running it. Pass the code as 'source', or a file in the workspace as 'path'.", sourceOrPath(), SOURCE_OR_PATH, LOOKUP),
    spec("pudu_format", "Format Pudu code", "Answer the code as the Pudu formatter lays it out. Never writes files.", sourceOrPath(), SOURCE_OR_PATH, LOOKUP),
    spec("pudu_lint", "Lint Pudu code", "Report lint findings for Pudu code, each with its rule code and a suggested fix where one is safe.", sourceOrPath(), SOURCE_OR_PATH, LOOKUP),
    spec("pudu_run", "Run a Pudu program", "Run a program's main function confined: it may print, read the clock, and use threads, but not files, processes, the network, or foreign code. Answers its output and exit status.", [
        ToolSpec.text("source", "A complete program with a main function.", true),
        ToolSpec.integer("timeoutMs", "Stop the program after this many milliseconds.", false, 100, Server.MAX_RUN_TIMEOUT_MS)
      ], [], CONFINED_RUN),
    spec("pudu_test", "Run Pudu tests", "Run the workspace's test suites with pudu test, or the suites under one path. Tests run with the workspace's full permissions.", [
        ToolSpec.text("path", "A test file or directory inside the workspace; defaults to every standard test directory.", false),
        ToolSpec.integer("timeoutMs", "Stop the tests after this many milliseconds.", false, 100, Server.MAX_RUN_TIMEOUT_MS)
      ], [], PROJECT_RUN),
    position("pudu_hover", "Hover", "The type and documentation of the name at a position."),
    position("pudu_definition", "Go to definition", "Where the name at a position is declared, with the declaration's source."),
    position("pudu_references", "Find references", "Every use of the name at a position."),
    position("pudu_completion", "Complete code", "What could be written at a position: names, members, and keywords."),
    position("pudu_signature_help", "Signature help", "The signature of the call around a position and which argument the position is in."),
    position("pudu_code_actions", "Code actions", "Quick fixes the language server offers at a position."),
    spec("pudu_rename_preview", "Preview a rename", "The edits that would rename the name at a position. Nothing is written; apply the edits yourself.", positionProperties().push(ToolSpec.text("newName", "The new name.", true)), SOURCE_OR_PATH, LOOKUP),
    spec("pudu_document_symbols", "Outline Pudu code", "Every declaration in the code, with its kind and line.", sourceOrPath(), SOURCE_OR_PATH, LOOKUP),
    spec("pudu_workspace_symbols", "Find workspace symbols", "Declarations across the workspace whose names match a query.", [
        ToolSpec.text("query", "Part of a declaration's name.", true)
      ], [], LOOKUP),
    spec("pudu_toolchain", "Pudu toolchain", "The installed compiler's version and location, the standard library in use, the workspace root, and the documentation revision this server carries.", [], [], LOOKUP)
  ]
}

/// The tool with a name.
export fn find(name: Str) -> Option[ToolSpec.ToolSpec] {
  List.find(&all(), |held: ToolSpec.ToolSpec| held.name == name)
}

/// A tool from its parts.
fn spec(name: Str, title: Str, description: Str, properties: Array[ToolSpec.Property], exactlyOne: Array[Str], annotations: ToolSpec.Annotations) -> ToolSpec.ToolSpec {
  ToolSpec.ToolSpec{name: name, title: title, description: description, properties: properties, exactlyOne: exactlyOne, annotations: annotations}
}

/// The `source` and `path` arguments.
fn sourceOrPath() -> Array[ToolSpec.Property] {
  [
    ToolSpec.text("source", "Pudu code, beginning with its module declaration.", false),
    ToolSpec.text("path", "A .pudu file relative to the workspace root.", false)
  ]
}

/// `source` or `path` with a 1-based line and character.
fn positionProperties() -> Array[ToolSpec.Property] {
  sourceOrPath().concat([
      ToolSpec.integer("line", "The 1-based line.", true, 1, 1000000),
      ToolSpec.integer("character", "The 1-based character within the line.", true, 1, 100000)
    ])
}

/// A language-server tool that asks about one position.
fn position(name: Str, title: Str, description: Str) -> ToolSpec.ToolSpec {
  spec(name, title, description + " Pass the code as 'source', or a workspace file as 'path', with a 1-based line and character.", positionProperties(), SOURCE_OR_PATH, LOOKUP)
}
