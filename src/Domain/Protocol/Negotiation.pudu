/** @Domain.Protocol.Negotiation.Backbone — admits requests by protocol era */
module Domain.Protocol.Negotiation

import Std.Json as Json
import Std.Text as Text
import Constants.Protocol as Protocol
import Errors.RpcError as RpcError
import Utils.JsonAccess as Access

/** @Domain.Protocol.Negotiation.Session — the only process-scoped protocol state */
export type Session = Unopened | Legacy(Str)

/** @Domain.Protocol.Negotiation.Era — version governing one admitted request */
export type Era = Modern | LegacyEra(Str)

/// The method that opens a legacy session.
const HANDSHAKE: Str = "initialize"

/// Whether a method opens a legacy session.
export fn isHandshake(method: Str) -> Bool {
  method == HANDSHAKE
}

/// The era governing one request, or the refusal to answer it with.
export fn admit(session: &Session, method: Str, params: &Json.Json) -> Result[Era, RpcError.ProtocolError] {
  let meta = match Access.member(params, Protocol.META_KEY) {
    case Some(Json.Object(fields)) => Json.Object(fields)
    case _ => Json.object(&[])
  }
  match Access.member(&meta, Protocol.META_PROTOCOL_VERSION) {
    case Some(Json.Text(requested)) => {
      if requested != Protocol.MODERN_VERSION {
        return Err(RpcError.UnsupportedVersion(requested))
      }
      match Access.member(&meta, Protocol.META_CLIENT_CAPABILITIES) {
        case Some(Json.Object(_)) => Ok(Modern)
        case _ => Err(RpcError.InvalidParams("_meta must include " + Protocol.META_CLIENT_CAPABILITIES + " as an object"))
      }
    }
    case Some(_) => Err(RpcError.InvalidParams(Protocol.META_PROTOCOL_VERSION + " must be a string"))
    case None => {
      if isHandshake(method) { return Ok(LegacyEra(negotiateLegacy(params))) }
      match session {
        case Legacy(version) => Ok(LegacyEra(version))
        case Unopened => Err(RpcError.InvalidParams("missing _meta " + Protocol.META_PROTOCOL_VERSION + "; send " + Protocol.MODERN_VERSION + " on every request, or call initialize first for " + Text.join(&Protocol.LEGACY_VERSIONS, ", ")))
      }
    }
  }
}

/// The legacy version an `initialize` receives.
export fn negotiateLegacy(params: &Json.Json) -> Str {
  match Access.text(params, "protocolVersion") {
    case Some(asked) => if Protocol.isLegacyVersion(asked) { asked } else { Protocol.LATEST_LEGACY_VERSION }
    case None => Protocol.LATEST_LEGACY_VERSION
  }
}
