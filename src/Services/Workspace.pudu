/** @Services.Workspace.Guard — confines paths and hosts inline source */
module Services.Workspace

import Std.Env as Env
import Std.Fs as Fs
import Std.Io as Io
import Std.Option as Option
import Std.Path as Path
import Constants.Server as Server
import Domain.Code.SourceFile as SourceFile
import Errors.ToolError as ToolError

/** @Services.Workspace.Workspace — the directory path arguments stay inside */
export type Workspace = { root: Str }

/** @Services.Workspace.Target — the file one command reads */
export type Target = { directory: Str, file: Str, source: Str, scratch: Bool }

/// The prefix of every scratch directory.
const SCRATCH_PREFIX: Str = "pudu-mcp-"

/// The file inline source is written to when it declares no module.
const DEFAULT_FILE: Str = "Main.pudu"

/// The workspace named by `PUDU_MCP_ROOT`, else the current directory.
export fn fromEnvironment() -> Workspace {
  at(Env.variableOr(Server.ENV_WORKSPACE, "."))
}

/// The workspace rooted at a directory, canonicalized when it exists.
export fn at(root: Str) -> Workspace {
  match Fs.canonical(root) {
    case Ok(real) => Workspace{root: real}
    case Err(_) => Workspace{root: root}
  }
}

/// The real location of `path` inside the workspace, or why it is refused.
export fn resolve(workspace: &Workspace, path: Str) -> Result[Str, ToolError.ToolFailure] {
  match Fs.resolveInside(workspace.root, path) {
    case Ok(real) => Ok(real)
    case Err(_) => Err(ToolError.OutsideWorkspace(path))
  }
}

/// A path relative to the workspace root when it is inside it.
export fn relative(workspace: &Workspace, path: Str) -> Str {
  if Path.isInside(workspace.root, path) { Option.unwrapOr(Path.relativeTo(workspace.root, path), path) } else { path }
}

/// Runs `use` on the file `source` or `path` names; scratch files are removed afterwards.
export fn withTarget[T](workspace: &Workspace, source: Option[Str], path: Option[Str], use: fn(Target) -> T) -> Result[T, ToolError.ToolFailure] {
  match (source, path) {
    case (_, Some(given)) => {
      let real = resolve(workspace, given) ?
      if !real.endsWith(".pudu") { return Err(ToolError.OutsideWorkspace(given)) }
      let text = match Io.read(real) {
        case Ok(content) => content
        case Err(_) => { return Err(ToolError.OutsideWorkspace(given)) }
      }
      Ok(use(Target{directory: workspace.root, file: real, source: text, scratch: false}))
    }
    case (Some(text), None) => {
      let directory = match Fs.temporaryDirectoryIn(Env.temporaryDirectory(), SCRATCH_PREFIX) {
        case Ok(made) => made
        case Err(_) => { return Err(ToolError.Unavailable("A scratch directory for the source could not be created.")) }
      }
      let placed = Option.unwrapOr(Option.map(SourceFile.moduleNameOf(text), |name: Str| SourceFile.fileOf(name)), DEFAULT_FILE)
      let file = Path.join(directory, placed)
      let written = Io.makeDirectory(Path.directoryOf(file)) == Ok(()) && Io.write(file, text) == Ok(())
      let answer = if written { Some(use(Target{directory: directory, file: file, source: text, scratch: true})) } else { None }
      let _removed = Fs.removeTree(directory)
      match answer {
        case Some(value) => Ok(value)
        case None => Err(ToolError.Unavailable("The source could not be written to a scratch directory."))
      }
    }
    case _ => Err(ToolError.ExactlyOne(["source", "path"]))
  }
}
