/** @Constants.Server.Vocabulary — server identity, limits, environment names */
module Constants.Server

/// The name reported in `serverInfo`.
export const SERVER_NAME: Str = "pudu-lang-mcp"
/// The display name reported in `serverInfo`.
export const SERVER_TITLE: Str = "Pudu Language"
/// This server's version; matches `pudu.toml`.
export const SERVER_VERSION: Str = "0.1.0"

/// Guidance for a model, returned by discovery and `initialize`.
export const INSTRUCTIONS: Str = "Tools for writing Pudu. Search and read the language documentation with pudu_docs_search and pudu_docs_read, and the installed standard library with pudu_stdlib_search and pudu_stdlib_module. Before presenting Pudu code, verify it with pudu_check, format it with pudu_format, and lint it with pudu_lint. pudu_hover, pudu_definition, and pudu_completion answer language-server questions at a line and character. pudu_run runs a program confined: no files, processes, network, or foreign code. Paths must be inside the workspace the server was started in."

/// The longest message line accepted, in bytes.
export const MAX_LINE_BYTES: Int = 8388608

/// Deadline for check, format, lint, and reference commands.
export const COMMAND_TIMEOUT_MS: Int = 20000
/// Deadline for one chunk of reference indexing.
export const REFERENCE_TIMEOUT_MS: Int = 60000

/// Most bytes kept from one reference-indexing run, whose JSON covers every imported module.
export const REFERENCE_OUTPUT_CAP_BYTES: Int = 67108864

/// Files per reference-indexing run.
export const REFERENCE_CHUNK: Int = 25

/// Reference-indexing runs at once.
export const REFERENCE_WORKERS: Int = 4

/// Longest a request waits for the background reference index.
export const INDEX_WAIT_MS: Int = 90000

/// Default deadline for `pudu_run` and `pudu_test`.
export const RUN_TIMEOUT_MS: Int = 10000
/// The longest deadline a caller may ask a run or test for.
export const MAX_RUN_TIMEOUT_MS: Int = 60000
/// Deadline for one language-server conversation.
export const LSP_TIMEOUT_MS: Int = 20000

/// Most bytes kept from each stream of a child process.
export const OUTPUT_CAP_BYTES: Int = 262144

/// Items per page of a list result.
export const PAGE_SIZE: Int = 50

/// Freshness hint for tool, prompt, resource, and discovery lists.
export const LIST_TTL_MS: Int = 3600000
/// Freshness hint for documentation reads.
export const DOCS_TTL_MS: Int = 3600000
/// Freshness hint for standard-library reads.
export const STDLIB_TTL_MS: Int = 300000

/// Most characters of one document or reference answered at once.
export const DOC_CHARS: Int = 60000

/// Search results answered when the caller names no limit.
export const DEFAULT_SEARCH_LIMIT: Int = 8
/// The most search results a caller may ask for.
export const MAX_SEARCH_LIMIT: Int = 25

/// Environment variable naming the `pudu` executable to use.
export const ENV_PUDU_BIN: Str = "PUDU_BIN"
/// Environment variable naming the standard library directory to use.
export const ENV_PUDU_LIB: Str = "PUDU_LIB"
/// Environment variable naming the workspace root.
export const ENV_WORKSPACE: Str = "PUDU_MCP_ROOT"
