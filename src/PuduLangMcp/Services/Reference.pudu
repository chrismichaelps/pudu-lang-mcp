/** @Services.Reference.Indexer — builds the declaration index from the compiler */
module PuduLangMcp.Services.Reference

import Std.Concurrent as Concurrent
import Std.Fs as Fs
import Std.Io as Io
import Std.List as List
import Std.Math as Math
import Std.Option as Option
import Std.Path as Path
import Std.Result as Result
import PuduLangMcp.Constants.Server as Server
import PuduLangMcp.Domain.Code.SourceFile as SourceFile
import PuduLangMcp.Domain.Reference.Decode as Decode
import PuduLangMcp.Domain.Reference.Entry as Entry
import PuduLangMcp.Errors.ToolError as ToolError
import PuduLangMcp.Services.Toolchain as Toolchain

/** @Services.Reference.ModuleFile — one importable module and its file */
export type ModuleFile = { moduleName: Str, path: Str, origin: Str }

/// Where the standard library's modules live under the library root.
const STD_DIRECTORY: Str = "Std"

/// Where a workspace keeps its installed packages.
const DEPS_DIRECTORY: Str = "deps"

/// How deep a directory walk goes before it stops.
const MAX_WALK_DEPTH: Int = 12

/// Every module file of the standard library and the workspace's installed packages.
export fn moduleFiles(library: Option[Str], workspaceRoot: Str) -> Array[ModuleFile] {
  var files: Array[ModuleFile] = []
  if let Some(root) = library {
    files = files.concat(named(root, &walk(Path.join(root, STD_DIRECTORY), 0), STD_DIRECTORY))
  }
  let deps = Path.join(workspaceRoot, DEPS_DIRECTORY)
  for package in Result.unwrapOr(Io.listPaths(deps), []) {
    if isDirectory(package) {
      let source = Path.join(package, "src")
      let root = if isDirectory(source) { source } else { package }
      files = files.concat(named(root, &walk(root, 0), Path.nameOf(package)))
    }
  }
  var seen: Set[Str] = setOf([])
  var unique: Array[ModuleFile] = []
  for file in files {
    if !seen.contains(file.moduleName) {
      seen = seen.insert(file.moduleName)
      unique = unique.push(file)
    }
  }
  List.sortOn(&unique, |file: ModuleFile| file.moduleName)
}

/// The file of one module.
export fn fileOf(files: &Array[ModuleFile], moduleName: Str) -> Option[ModuleFile] {
  List.find(files, |file: ModuleFile| file.moduleName == moduleName)
}

/// The public declarations of every file, from the compiler's reference output.
export fn build(toolchain: &Toolchain.Toolchain, files: &Array[ModuleFile]) -> Result[Array[Entry.Entry], ToolError.ToolFailure] {
  if toolchain.compiler == None { return Err(ToolError.ToolchainMissing) }
  let chunks = chunked(&files.map(|file: ModuleFile| file.path), Server.REFERENCE_CHUNK)
  let runner = *toolchain
  let decoded = match Concurrent.mapBounded(&chunks, Server.REFERENCE_WORKERS, fn(chunk: Array[Str]) -> Result[Array[Entry.Entry], Str] {
      indexChunk(&runner, &chunk)
    }) {
    case Ok(results) => results
    case Err(_) => { return Err(ToolError.Unavailable("The reference index could not be built in parallel.")) }
  }
  var seen: Set[Str] = setOf([])
  var entries: Array[Entry.Entry] = []
  for result in decoded {
    match result {
      case Ok(found) => {
        for entry in found {
          let key = entry.moduleName + "." + entry.name + " " + entry.kind + " " + entry.signature
          if !seen.contains(key) {
            seen = seen.insert(key)
            entries = entries.push(entry)
          }
        }
      }
      case Err(problem) => { return Err(ToolError.Unavailable("The reference index could not be built: " + problem)) }
    }
  }
  Ok(entries)
}

/// The public declarations of one module's file.
export fn moduleEntries(toolchain: &Toolchain.Toolchain, file: &ModuleFile) -> Result[Array[Entry.Entry], ToolError.ToolFailure] {
  if toolchain.compiler == None { return Err(ToolError.ToolchainMissing) }
  match indexChunk(toolchain, &[file.path]) {
    case Ok(found) => Ok(found.filter(|entry: Entry.Entry| entry.moduleName == file.moduleName))
    case Err(problem) => Err(ToolError.Unavailable("The reference for " + file.moduleName + " could not be read: " + problem))
  }
}

/// The public declarations of one chunk of files.
fn indexChunk(toolchain: &Toolchain.Toolchain, chunk: &Array[Str]) -> Result[Array[Entry.Entry], Str] {
  let api = toolchain.run(["api", "--json"].concat(*chunk), "", "", Server.REFERENCE_TIMEOUT_MS, Server.REFERENCE_OUTPUT_CAP_BYTES) ?
  if api.timedOut { return Err("pudu api timed out") }
  let exports = Decode.exportsOf(api.output) ?
  let doc = toolchain.run(["doc", "--json"].concat(*chunk), "", "", Server.REFERENCE_TIMEOUT_MS, Server.REFERENCE_OUTPUT_CAP_BYTES) ?
  if doc.timedOut { return Err("pudu doc timed out") }
  Decode.entriesOf(doc.output, &exports)
}

/// Every `.pudu` file under a directory, without following links to directories.
fn walk(directory: Str, depth: Int) -> Array[Str] {
  if depth > MAX_WALK_DEPTH { return [] }
  var found: Array[Str] = []
  for path in Result.unwrapOr(Io.listPaths(directory), []) {
    if isDirectory(path) {
      found = found.concat(walk(path, depth + 1))
    } else if path.endsWith(".pudu") {
      found = found.push(path)
    }
  }
  found
}

/// Files named by their module, relative to the source root they sit under.
fn named(root: Str, paths: &Array[Str], origin: Str) -> Array[ModuleFile] {
  var files: Array[ModuleFile] = []
  for path in *paths {
    if let Some(relative) = Path.relativeTo(root, path) {
      if let Some(moduleName) = SourceFile.moduleOfFile(relative) {
        files = files.push(ModuleFile{moduleName: moduleName, path: path, origin: origin})
      }
    }
  }
  files
}

/// Whether a path is a directory that is not a symbolic link.
fn isDirectory(path: Str) -> Bool {
  match Fs.metadata(path) {
    case Ok(found) => found.isDirectory && !found.isSymbolicLink
    case Err(_) => false
  }
}

/// Items in consecutive groups of at most `size`.
fn chunked(items: &Array[Str], size: Int) -> Array[Array[Str]] {
  var groups: Array[Array[Str]] = []
  var start = 0
  while start < items.length() {
    let end = Math.min(start + size, items.length())
    groups = groups.push(items.slice(start, end))
    start = end
  }
  groups
}
