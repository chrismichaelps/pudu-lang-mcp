/** @Domain.Reference.Decode.Module — compiler reference output as entries */
module PuduLangMcp.Domain.Reference.Decode

import Std.Json as Json
import Std.Option as Option
import PuduLangMcp.Domain.Reference.Entry as Entry
import PuduLangMcp.Utils.JsonAccess as Access

/// The qualified names `pudu api --json` reports as public.
export fn exportsOf(apiJson: Str) -> Result[Set[Str], Str] {
  let value = match Json.decode(apiJson) {
    case Ok(decoded) => decoded
    case Err(problem) => { return Err("api output is not JSON: " + Json.explain(&problem)) }
  }
  let items = match Access.member(&value, "exports") {
    case Some(Json.List(found)) => found
    case _ => { return Err("api output has no exports") }
  }
  var names: Set[Str] = setOf([])
  for item in items {
    names = names.insert(Option.unwrapOr(Access.text(&item, "module"), "") + "." + Option.unwrapOr(Access.text(&item, "name"), ""))
  }
  Ok(names)
}

/// The exported declarations in `pudu doc --json` output, each once.
export fn entriesOf(docJson: Str, exports: &Set[Str]) -> Result[Array[Entry.Entry], Str] {
  let value = match Json.decode(docJson) {
    case Ok(decoded) => decoded
    case Err(problem) => { return Err("doc output is not JSON: " + Json.explain(&problem)) }
  }
  let items = match Access.member(&value, "entries") {
    case Some(Json.List(found)) => found
    case _ => { return Err("doc output has no entries") }
  }
  var seen: Set[Str] = setOf([])
  var entries: Array[Entry.Entry] = []
  for item in items {
    let moduleName = Option.unwrapOr(Access.text(&item, "module"), "")
    let name = Option.unwrapOr(Access.text(&item, "name"), "")
    let kind = Option.unwrapOr(Access.text(&item, "kind"), "")
    let signature = Option.unwrapOr(Access.text(&item, "signature"), "")
    let key = moduleName + "." + name + " " + kind + " " + signature
    if exports.contains(moduleName + "." + name) && !seen.contains(key) {
      seen = seen.insert(key)
      let doc = match Access.member(&item, "doc") {
        case Some(Json.List(lines)) => lines.map(|line: Json.Json| Option.unwrapOr(Json.asText(&line), "")).join("\n")
        case _ => ""
      }
      entries = entries.push(Entry.Entry{moduleName: moduleName, kind: kind, name: name, signature: signature, doc: doc})
    }
  }
  Ok(entries)
}
