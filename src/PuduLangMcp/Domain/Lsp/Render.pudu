/** @Domain.Lsp.Render.Module — language server results as text */
module PuduLangMcp.Domain.Lsp.Render

import Std.Json as Json
import Std.List as List
import Std.Map as Map
import Std.Option as Option
import PuduLangMcp.Utils.JsonAccess as Access

/** @Domain.Lsp.Render.Location — a 1-based position in a shown path */
export type Location = { uri: Str, path: Str, line: Int, character: Int, endLine: Int }

/// LSP symbol kinds by number.
const SYMBOL_KINDS: Map[Int, Str] = mapOf([
    (1, "file"), (2, "module"), (3, "namespace"), (4, "package"), (5, "class"), (6, "method"),
    (7, "property"), (8, "field"), (9, "constructor"), (10, "enum"), (11, "interface"), (12, "function"),
    (13, "variable"), (14, "constant"), (15, "string"), (16, "number"), (17, "boolean"), (18, "array"),
    (19, "object"), (20, "key"), (21, "null"), (22, "enum member"), (23, "struct"), (24, "event"),
    (25, "operator"), (26, "type parameter")
  ])

/// LSP diagnostic severities by number.
const SEVERITIES: Map[Int, Str] = mapOf([(1, "error"), (2, "warning"), (3, "information"), (4, "hint")])

/// The hover contents as text.
export fn hover(result: &Json.Json) -> Str {
  match result {
    case Json.Null => "No information at this position."
    case _ => match Access.member(result, "contents") {
      case Some(contents) => markup(&contents)
      case None => Json.encode(result)
    }
  }
}

/// Every location in a definition or references result.
export fn locations(result: &Json.Json, shown: fn(Str) -> Str) -> Array[Location] {
  let items = match result {
    case Json.List(values) => values
    case Json.Null => []
    case _ => [*result]
  }
  var found: Array[Location] = []
  for item in items {
    let uri = Option.orElse(Access.text(&item, "uri"), Access.text(&item, "targetUri"))
    let range = Option.orElse(Access.member(&item, "range"), Access.member(&item, "targetRange"))
    match (uri, range) {
      case (Some(target), Some(span)) => {
        let start = startOf(&span)
        found = found.push(Location{uri: target, path: shown(target), line: start[0], character: start[1], endLine: endOf(&span)[0]})
      }
      case _ => ()
    }
  }
  found
}

/// A location as `path:line:character`.
export fn locationLine(held: &Location) -> Str {
  held.path + ":" + show(held.line) + ":" + show(held.character)
}

/// Completion items, one per line, at most `limit`.
export fn completion(result: &Json.Json, limit: Int) -> Str {
  let items = match result {
    case Json.List(values) => values
    case Json.Null => []
    case _ => match Access.member(result, "items") { case Some(Json.List(values)) => values case _ => [] }
  }
  if items.isEmpty() { return "No completions at this position." }
  let shownItems = List.take(&items, limit).map(|item: Json.Json| {
      let label = Option.unwrapOr(Access.text(&item, "label"), "?")
      match Access.text(&item, "detail") {
        case Some(detail) => label + " — " + detail
        case None => label
      }
    })
  let rest = items.length() - shownItems.length()
  shownItems.join("\n") + (if rest > 0 { "\n… and " + show(rest) + " more" } else { "" })
}

/// The active signature, its active parameter, and its documentation.
export fn signatureHelp(result: &Json.Json) -> Str {
  let signatures = match Access.member(result, "signatures") { case Some(Json.List(values)) => values case _ => [] }
  if signatures.isEmpty() { return "No signature at this position." }
  let active = Access.integer(result, "activeSignature")
  let chosen = Option.unwrapOr(List.get(&signatures, Option.unwrapOr(active, 0)), signatures[0])
  let label = Option.unwrapOr(Access.text(&chosen, "label"), "")
  var lines = [label]
  let parameters = match Access.member(&chosen, "parameters") { case Some(Json.List(values)) => values case _ => [] }
  let activeParameter = Option.orElse(Access.integer(result, "activeParameter"), Access.integer(&chosen, "activeParameter"))
  if let Some(index) = activeParameter {
    if let Some(parameter) = List.get(&parameters, index) {
      match Access.member(&parameter, "label") {
        case Some(Json.Text(text)) => { lines = lines.push("active parameter: " + text) }
        case Some(Json.List(bounds)) => {
          match (List.get(&bounds, 0), List.get(&bounds, 1)) {
            case (Some(Json.Number(from)), Some(Json.Number(to))) => { lines = lines.push("active parameter: " + label.slice(from, to)) }
            case _ => ()
          }
        }
        case _ => ()
      }
    }
  }
  if let Some(documentation) = Access.member(&chosen, "documentation") { lines = lines.push(markup(&documentation)) }
  lines.join("\n")
}

/// Code action titles, one per line.
export fn codeActions(result: &Json.Json) -> Str {
  let actions = match result { case Json.List(values) => values case _ => [] }
  if actions.isEmpty() { return "No code actions at this position." }
  actions.map(|action: Json.Json| {
      let title = Option.unwrapOr(Access.text(&action, "title"), "?")
      match Access.text(&action, "kind") {
        case Some(kind) => title + " (" + kind + ")"
        case None => title
      }
    }).join("\n")
}

/// The edits of a rename, one per line.
export fn workspaceEdit(result: &Json.Json, shown: fn(Str) -> Str) -> Str {
  var lines: Array[Str] = []
  for change in Access.members(&Option.unwrapOr(Access.member(result, "changes"), Json.Null)) {
    lines = lines.concat(editLines(shown(change[0]), &change[1]))
  }
  match Access.member(result, "documentChanges") {
    case Some(Json.List(documents)) => {
      for document in documents {
        let uri = Option.unwrapOr(Access.pathText(&document, &["textDocument", "uri"]), "")
        lines = lines.concat(editLines(shown(uri), &Option.unwrapOr(Access.member(&document, "edits"), Json.Null)))
      }
    }
    case _ => ()
  }
  if lines.isEmpty() { "No edits." } else { lines.join("\n") }
}

/// A document's declarations, nested ones indented.
export fn documentSymbols(result: &Json.Json) -> Str {
  let lines = symbolLines(result, "")
  if lines.isEmpty() { "No declarations." } else { lines.join("\n") }
}

/// Matching declarations with where each is.
export fn workspaceSymbols(result: &Json.Json, shown: fn(Str) -> Str) -> Str {
  let symbols = match result { case Json.List(values) => values case _ => [] }
  if symbols.isEmpty() { return "No matching declarations." }
  symbols.map(|symbol: Json.Json| {
      let name = Option.unwrapOr(Access.text(&symbol, "name"), "?")
      let kind = kindName(Access.integer(&symbol, "kind"))
      let placed = match Access.member(&symbol, "location") {
        case Some(place) => {
          let found = locations(&place, shown)
          match List.first(&found) { case Some(first) => " — " + locationLine(&first) case None => "" }
        }
        case None => ""
      }
      kind + " " + name + placed
    }).join("\n")
}

/// Diagnostics, one per line with position, severity, and code.
export fn diagnostics(items: &Array[Json.Json]) -> Str {
  if items.isEmpty() { return "No diagnostics." }
  items.map(|item: Json.Json| {
      let start = startOf(&Option.unwrapOr(Access.member(&item, "range"), Json.Null))
      let severity = Map.getOr(&SEVERITIES, Option.unwrapOr(Access.integer(&item, "severity"), 1), "error")
      let code = match Access.member(&item, "code") {
        case Some(Json.Text(text)) => " [" + text + "]"
        case Some(Json.Number(number)) => " [" + show(number) + "]"
        case _ => ""
      }
      show(start[0]) + ":" + show(start[1]) + " " + severity + code + " " + Option.unwrapOr(Access.text(&item, "message"), "")
    }).join("\n")
}

/// Markup content, a string, or a list of either, as text.
fn markup(contents: &Json.Json) -> Str {
  match contents {
    case Json.Text(text) => text
    case Json.List(parts) => parts.map(|part: Json.Json| markup(&part)).join("\n\n")
    case _ => match Access.text(contents, "value") {
      case Some(text) => text
      case None => Json.encode(contents)
    }
  }
}

/// Lines for symbols and their children.
fn symbolLines(result: &Json.Json, indent: Str) -> Array[Str] {
  let symbols = match result { case Json.List(values) => values case _ => [] }
  var lines: Array[Str] = []
  for symbol in symbols {
    let name = Option.unwrapOr(Access.text(&symbol, "name"), "?")
    let kind = kindName(Access.integer(&symbol, "kind"))
    let detail = match Access.text(&symbol, "detail") { case Some(text) => if text.isEmpty() { "" } else { " — " + text } case None => "" }
    let span = Option.orElse(Access.member(&symbol, "selectionRange"), Option.orElse(Access.member(&symbol, "range"), Json.path(&symbol, &["location", "range"])))
    let line = match span { case Some(held) => " (line " + show(startOf(&held)[0]) + ")" case None => "" }
    lines = lines.push(indent + kind + " " + name + detail + line)
    match Access.member(&symbol, "children") {
      case Some(children) => { lines = lines.concat(symbolLines(&children, indent + "  ")) }
      case None => ()
    }
  }
  lines
}

/// Lines for the text edits of one file.
fn editLines(path: Str, edits: &Json.Json) -> Array[Str] {
  let items = match edits { case Json.List(values) => values case _ => [] }
  items.map(|edit: Json.Json| {
      let span = Option.unwrapOr(Access.member(&edit, "range"), Json.Null)
      let start = startOf(&span)
      let end = endOf(&span)
      path + ":" + show(start[0]) + ":" + show(start[1]) + "-" + show(end[0]) + ":" + show(end[1]) + " → " + Option.unwrapOr(Access.text(&edit, "newText"), "")
    })
}

/// The name of a symbol kind.
fn kindName(kind: Option[Int]) -> Str {
  match kind {
    case Some(number) => Map.getOr(&SYMBOL_KINDS, number, "symbol")
    case None => "symbol"
  }
}

/// The 1-based start of a range.
fn startOf(span: &Json.Json) -> (Int, Int) {
  pointOf(span, "start")
}

/// The 1-based end of a range.
fn endOf(span: &Json.Json) -> (Int, Int) {
  pointOf(span, "end")
}

/// One end of a range, 1-based.
fn pointOf(span: &Json.Json, name: Str) -> (Int, Int) {
  let line = Option.unwrapOr(Access.pathInt(span, &[name, "line"]), 0)
  let character = Option.unwrapOr(Access.pathInt(span, &[name, "character"]), 0)
  (line + 1, character + 1)
}
