/** @Domain.Catalog.Arguments.Module — validates tool arguments against specs */
module PuduLangMcp.Domain.Catalog.Arguments

import Std.Json as Json
import Std.List as List
import Std.Text as Text
import PuduLangMcp.Domain.Catalog.ToolSpec as ToolSpec
import PuduLangMcp.Errors.ToolError as ToolError
import PuduLangMcp.Utils.JsonAccess as Access

/** @Domain.Catalog.Arguments.Args — validated arguments of one call */
export type Args = { values: Array[(Str, Json.Json)] }

/// Arguments checked against a tool's spec, or the first problem found.
export fn validate(spec: &ToolSpec.ToolSpec, arguments: &Json.Json) -> Result[Args, ToolError.ToolFailure] {
  let given = match arguments {
    case Json.Null => []
    case Json.Object(fields) => fields
    case _ => { return Err(ToolError.NotAnObject) }
  }
  let declared = spec.properties.map(|held: ToolSpec.Property| held.name)
  for member in given {
    if !declared.contains(member[0]) { return Err(ToolError.UnknownArgument(member[0])) }
  }
  for property in spec.properties {
    match List.lookup(&given, property.name) {
      case None => {
        if property.required { return Err(ToolError.MissingArgument(property.name)) }
      }
      case Some(value) => {
        let problem = checked(&property, &value)
        match problem {
          case Some(failure) => { return Err(failure) }
          case None => ()
        }
      }
    }
  }
  if !spec.exactlyOne.isEmpty() {
    let present = spec.exactlyOne.filter(|name: Str| List.lookup(&given, name) != None).length()
    if present != 1 { return Err(ToolError.ExactlyOne(spec.exactlyOne)) }
  }
  Ok(Args{values: given})
}

/// A validated string argument.
export fn text(args: &Args, name: Str) -> Option[Str] {
  let held = List.lookup(&args.values, name) ?
  Json.asText(&held)
}

/// A validated integer argument.
export fn integer(args: &Args, name: Str) -> Option[Int] {
  let held = List.lookup(&args.values, name) ?
  Json.asInt(&held)
}

/// A validated integer argument, or a fallback when it was not given.
export fn integerOr(args: &Args, name: Str, fallback: Int) -> Int {
  match integer(args, name) {
    case Some(value) => value
    case None => fallback
  }
}

/// The problem with one given argument, if any.
fn checked(property: &ToolSpec.Property, value: &Json.Json) -> Option[ToolError.ToolFailure] {
  let expected = ToolSpec.kindName(&property.kind)
  if Access.kindOf(value) != expected { return Some(ToolError.WrongType(property.name, article(expected))) }
  match value {
    case Json.Text(content) => {
      if property.required && Text.isBlank(content) { return Some(ToolError.WrongType(property.name, "a non-empty string")) }
      None
    }
    case Json.Number(number) => {
      let low = match property.minimum { case Some(bound) => bound case None => number }
      let high = match property.maximum { case Some(bound) => bound case None => number }
      if number < low || number > high { Some(ToolError.OutOfRange(property.name, "between " + show(low) + " and " + show(high))) } else { None }
    }
    case _ => None
  }
}

/// A kind name with its indefinite article.
fn article(kind: Str) -> Str {
  if kind == "integer" { "an integer" } else { "a " + kind }
}
