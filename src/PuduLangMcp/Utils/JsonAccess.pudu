/** @Utils.JsonAccess.Helper — typed member access over JSON values */
module PuduLangMcp.Utils.JsonAccess

import Std.Json as Json
import Std.Option as Option

/// A member of an object, or `None`.
export fn member(value: &Json.Json, name: Str) -> Option[Json.Json] {
  Json.field(value, name)
}

/// A string member, or `None` when absent or of another kind.
export fn text(value: &Json.Json, name: Str) -> Option[Str] {
  let held = Json.field(value, name) ?
  Json.asText(&held)
}

/// An integer member, or `None` when absent or of another kind.
export fn integer(value: &Json.Json, name: Str) -> Option[Int] {
  let held = Json.field(value, name) ?
  Json.asInt(&held)
}

/// A boolean member, or `None` when absent or of another kind.
export fn boolean(value: &Json.Json, name: Str) -> Option[Bool] {
  let held = Json.field(value, name) ?
  Json.asBool(&held)
}

/// An object's members in order; empty for any other value.
export fn members(value: &Json.Json) -> Array[(Str, Json.Json)] {
  Option.unwrapOr(Json.asObject(value), [])
}

/// The JSON Schema type name of a value.
export fn kindOf(value: &Json.Json) -> Str {
  match value {
    case Json.Null => "null"
    case Json.Boolean(_) => "boolean"
    case Json.Number(_) => "integer"
    case Json.Fractional(_) => "number"
    case Json.Text(_) => "string"
    case Json.List(_) => "array"
    case Json.Object(_) => "object"
  }
}

/// A JSON array of strings.
export fn texts(values: &Array[Str]) -> Json.Json {
  Json.list(&values.map(|value: Str| Json.Text(value)))
}

/// The string at a path of member names, or `None`.
export fn pathText(value: &Json.Json, steps: &Array[Str]) -> Option[Str] {
  let held = Json.path(value, steps) ?
  Json.asText(&held)
}

/// The integer at a path of member names, or `None`.
export fn pathInt(value: &Json.Json, steps: &Array[Str]) -> Option[Int] {
  let held = Json.path(value, steps) ?
  Json.asInt(&held)
}
