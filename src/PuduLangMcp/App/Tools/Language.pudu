/** @App.Tools.Language.Handler — language server questions as tools */
module PuduLangMcp.App.Tools.Language

import Std.Io as Io
import Std.Json as Json
import Std.List as List
import Std.Math as Math
import Std.Option as Option
import Std.Path as Path
import Std.Result as Result
import PuduLangMcp.App.Context as Context
import PuduLangMcp.Constants.Server as Server
import PuduLangMcp.Domain.Catalog.Arguments as Arguments
import PuduLangMcp.Domain.Lsp.Conversation as Conversation
import PuduLangMcp.Domain.Lsp.Render as Render
import PuduLangMcp.Errors.ToolError as ToolError
import PuduLangMcp.Services.Lsp as Lsp
import PuduLangMcp.Services.Workspace as Workspace
import PuduLangMcp.Utils.TextBounds as TextBounds
import PuduLangMcp.Utils.Uri as Uri

/// Lines of a declaration's source shown under a definition.
const EXCERPT_LINES: Int = 12

/// Most completion items answered.
const COMPLETION_LIMIT: Int = 60

/// How the inline source file is shown.
const SOURCE_LABEL: Str = "<source>"

/// Answers the type and documentation at a position.
export fn hover(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/hover", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str { Render.hover(&result) })
}

/// Answers where the name at a position is declared, with its source.
export fn definition(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  let library = context.toolchain.library
  let workspace = context.workspace
  ask(context, args, "textDocument/definition", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str {
      let found = Render.locations(&result, shown)
      if found.isEmpty() { return "No definition at this position." }
      found.map(|held: Render.Location| Render.locationLine(&held) + excerpt(&held, &target, &workspace, &library)).join("\n\n")
    })
}

/// Answers every use of the name at a position.
export fn references(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/references", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str {
      let found = Render.locations(&result, shown)
      if found.isEmpty() { "No references at this position." } else { found.map(|held: Render.Location| Render.locationLine(&held)).join("\n") }
    })
}

/// Answers what could be written at a position.
export fn completion(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/completion", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str { Render.completion(&result, COMPLETION_LIMIT) })
}

/// Answers the signature of the call around a position.
export fn signatureHelp(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/signatureHelp", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str { Render.signatureHelp(&result) })
}

/// Answers the quick fixes offered at a position.
export fn codeActions(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/codeAction", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str { Render.codeActions(&result) })
}

/// Answers the edits a rename would make, without applying them.
export fn renamePreview(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/rename", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str { Render.workspaceEdit(&result, shown) })
}

/// Answers every declaration in the code.
export fn documentSymbols(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  ask(context, args, "textDocument/documentSymbol", fn(result: Json.Json, shown: fn(Str) -> Str, target: Workspace.Target) -> Str { Render.documentSymbols(&result) })
}

/// Answers declarations across the workspace whose names match the query.
export fn workspaceSymbols(context: &Context.Context, args: &Arguments.Args) -> Result[Str, ToolError.ToolFailure] {
  let question = Conversation.Question{method: "workspace/symbol", line: 1, character: 1, newName: "", query: Option.unwrapOr(Arguments.text(args, "query"), "")}
  let shown = shownPath(context, None)
  let answer = Lsp.ask(&context.toolchain, Uri.fileUri(context.workspace.root), "", "", context.workspace.root, &question) ?
  match answer.error {
    case Some(message) => Ok("The language server answered: " + message)
    case None => Ok(TextBounds.bounded(Render.workspaceSymbols(&Option.unwrapOr(answer.result, Json.Null), shown), Server.DOC_CHARS))
  }
}

/// Asks one position question about the code `source` or `path` names.
fn ask(context: &Context.Context, args: &Arguments.Args, method: Str, render: fn(Json.Json, fn(Str) -> Str, Workspace.Target) -> Str) -> Result[Str, ToolError.ToolFailure] {
  let question = Conversation.Question {
    method: method,
    line: Arguments.integerOr(args, "line", 1),
    character: Arguments.integerOr(args, "character", 1),
    newName: Option.unwrapOr(Arguments.text(args, "newName"), ""),
    query: ""
  }
  let owner = *context
  let answered = Workspace.withTarget(&context.workspace, Arguments.text(args, "source"), Arguments.text(args, "path"), fn(target: Workspace.Target) -> Result[Str, ToolError.ToolFailure] {
      let answer = Lsp.ask(&owner.toolchain, Uri.fileUri(target.directory), Uri.fileUri(target.file), target.source, target.directory, &question) ?
      match answer.error {
        case Some(message) => Ok("The language server answered: " + message)
        case None => Ok(TextBounds.bounded(render(Option.unwrapOr(answer.result, Json.Null), shownPath(&owner, if target.scratch { Some(target.file) } else { None }), target), Server.DOC_CHARS))
      }
    }) ?
  answered
}

/// How a URI the language server names is shown to the model.
fn shownPath(context: &Context.Context, scratchFile: Option[Str]) -> fn(Str) -> Str {
  let library = context.toolchain.library
  let workspace = context.workspace
  fn(uri: Str) -> Str {
    let path = Option.unwrapOr(Uri.pathOfFileUri(uri), uri)
    if let Some(file) = scratchFile {
      if path == file { return SOURCE_LABEL }
    }
    if Path.isInside(workspace.root, path) { return Workspace.relative(&workspace, path) }
    match library {
      case Some(root) => if Path.isInside(root, path) { Option.unwrapOr(Path.relativeTo(root, path), path) } else { path }
      case None => path
    }
  }
}

/// Source lines of a declaration, when its file is one this server may read.
fn excerpt(held: &Render.Location, target: &Workspace.Target, workspace: &Workspace.Workspace, library: &Option[Str]) -> Str {
  let path = Option.unwrapOr(Uri.pathOfFileUri(held.uri), "")
  let readable = path == target.file || Path.isInside(workspace.root, path) || (match library { case Some(root) => Path.isInside(root, path) case None => false })
  if !readable { return "" }
  let text = if path == target.file { target.source } else { Result.unwrapOr(Io.read(path), "") }
  let lines = text.split("\n")
  let start = held.line - 1
  if start >= lines.length() { return "" }
  let end = Math.min(start + EXCERPT_LINES, lines.length())
  "\n```pudu\n" + lines.slice(start, end).join("\n") + "\n```"
}
