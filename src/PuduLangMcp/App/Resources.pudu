/** @App.Resources.Handler — documentation and reference as resources */
module PuduLangMcp.App.Resources

import Std.Json as Json
import PuduLangMcp.App.Context as Context
import PuduLangMcp.App.Tools.Reference as Reference
import PuduLangMcp.Constants.Protocol as Protocol
import PuduLangMcp.Constants.Server as Server
import PuduLangMcp.Domain.Docs.Chapter as Chapter
import PuduLangMcp.Domain.Protocol.Pagination as Pagination
import PuduLangMcp.Domain.Rpc.Reply as Reply
import PuduLangMcp.Errors.RpcError as RpcError
import PuduLangMcp.Errors.ToolError as ToolError
import PuduLangMcp.Utils.JsonAccess as Access
import PuduLangMcp.Utils.Uri as Uri

/// The table of contents of the documentation.
export const INDEX_URI: Str = "pudu://docs/index"

/// What every module-reference URI begins with.
export const REFERENCE_PREFIX: Str = "pudu://reference/"

/// The scheme of every resource this server offers.
const SCHEME: Str = "pudu://"

/// The media type of documentation.
const MARKDOWN: Str = "text/markdown"

/// The media type of a module reference.
const PLAIN_TEXT: Str = "text/plain"

/// Answers one page of the documentation resources.
export fn list(context: &Context.Context, params: &Json.Json) -> Result[Json.Json, RpcError.ProtocolError] {
  let cursor = Pagination.cursorOf(params) ?
  let all = [resource(INDEX_URI, "index", "Pudu documentation contents")].concat(context.chapters.map(|held: Chapter.Chapter| resource(SCHEME + held.group + "/" + held.slug, held.group + "/" + held.slug, held.title)))
  let paged = Pagination.page(&all, &cursor, Server.PAGE_SIZE) ?
  var fields = [("resources", Json.list(&paged[0]))]
  if let Some(next) = paged[1] { fields = fields.push(("nextCursor", Json.Text(next))) }
  Ok(Reply.complete(&fields, &Reply.Cached(Server.LIST_TTL_MS, Protocol.CACHE_PUBLIC)))
}

/// Answers the module-reference template.
export fn templates(context: &Context.Context, params: &Json.Json) -> Result[Json.Json, RpcError.ProtocolError] {
  let cursor = Pagination.cursorOf(params) ?
  let template = Json.object(&[
      ("uriTemplate", Json.Text(REFERENCE_PREFIX + "\{module\}")),
      ("name", Json.Text("reference")),
      ("title", Json.Text("Module reference")),
      ("description", Json.Text("Every public declaration of one standard-library or installed-package module.")),
      ("mimeType", Json.Text(PLAIN_TEXT))
    ])
  let paged = Pagination.page(&[template], &cursor, Server.PAGE_SIZE) ?
  Ok(Reply.complete(&[("resourceTemplates", Json.list(&paged[0]))], &Reply.Cached(Server.LIST_TTL_MS, Protocol.CACHE_PUBLIC)))
}

/// Answers the contents of one resource.
export fn read(context: &Context.Context, params: &Json.Json) -> Result[Json.Json, RpcError.ProtocolError] {
  let uri = match Access.text(params, "uri") {
    case Some(given) => given
    case None => { return Err(RpcError.InvalidParams("uri must be a string")) }
  }
  if uri == INDEX_URI {
    return Ok(contents(uri, MARKDOWN, Chapter.tableOfContents(&context.chapters), Server.DOCS_TTL_MS, Protocol.CACHE_PUBLIC))
  }
  if let Some(moduleName) = Uri.resourcePath(uri, REFERENCE_PREFIX) {
    return match Reference.moduleText(context, moduleName) {
      case Ok(text) => Ok(contents(uri, PLAIN_TEXT, text, Server.STDLIB_TTL_MS, Protocol.CACHE_PRIVATE))
      case Err(ToolError.NotFound(_)) => Err(RpcError.ResourceNotFound(uri))
      case Err(failure) => Err(RpcError.Internal(ToolError.explain(&failure)))
    }
  }
  let path = match Uri.resourcePath(uri, SCHEME) {
    case Some(rest) => rest
    case None => { return Err(RpcError.ResourceNotFound(uri)) }
  }
  let slash = path.indexOf("/")
  if slash == -1 { return Err(RpcError.ResourceNotFound(uri)) }
  match Chapter.find(&context.chapters, path.take(slash), path.drop(slash + 1)) {
    case Some(held) => Ok(contents(uri, MARKDOWN, held.markdown, Server.DOCS_TTL_MS, Protocol.CACHE_PUBLIC))
    case None => Err(RpcError.ResourceNotFound(uri))
  }
}

/// One listed resource.
fn resource(uri: Str, name: Str, title: Str) -> Json.Json {
  Json.object(&[("uri", Json.Text(uri)), ("name", Json.Text(name)), ("title", Json.Text(title)), ("mimeType", Json.Text(MARKDOWN))])
}

/// A read result holding one text content.
fn contents(uri: Str, mimeType: Str, text: Str, ttl: Int, visibility: Str) -> Json.Json {
  Reply.complete(&[
      ("contents", Json.list(&[Json.object(&[("uri", Json.Text(uri)), ("mimeType", Json.Text(mimeType)), ("text", Json.Text(text))])]))
    ], &Reply.Cached(ttl, visibility))
}
