/** @Tools.Mutate.Harness — mutation testing over the source tree */
module Mutate

import Std.Char as Char
import Std.Env as Env
import Std.Io as Io
import Std.List as List
import Std.Option as Option
import Std.Result as Result
import Std.Text as Text
import PuduLangMcp.Services.Process.Bounded as Bounded
import PuduLangMcp.Services.Toolchain as Toolchain

/** @Tools.Mutate.Mutant — one single-point change to one file */
type Mutant = { file: Str, line: Int, column: Int, from: Str, to: Str }

/// Operator replacements, tried at every code position in this order.
const OPERATORS: Array[(Str, Str)] = [
  ("==", "!="), ("!=", "=="), ("<=", "<"), (">=", ">"), ("<", "<="), (">", ">="),
  ("&&", "||"), ("||", "&&"), ("true", "false"), ("false", "true"), ("+ 1", "- 1"), ("- 1", "+ 1"), ("!", "")
]

/// Longest a mutant's test run may take before it counts as killed.
const MUTANT_TIMEOUT_MS: Int = 180000

/// Most bytes kept from one run's output.
const RUN_CAP_BYTES: Int = 1048576

/// Files under `src/` that are never mutated.
const EXCLUDED: Array[Str] = ["src/Main.pudu"]

/// The directory of generated code, which is never mutated.
const GENERATED: Str = "src/PuduLangMcp/Generated/"

/// Runs the harness and answers 0, or 1 when the score is below the threshold.
fn main() -> Int {
  let every = Option.unwrapOr(Option.andThen(Env.option("--every"), |given: Str| Text.countOf(given)), 1)
  let threshold = Option.unwrapOr(Option.andThen(Env.option("--threshold"), |given: Str| Text.countOf(given)), 0)
  let files = match Env.option("--file") {
    case Some(one) => [one]
    case None => sources("src")
  }
  var all: Array[Mutant] = []
  for file in files {
    all = all.concat(mutantsOf(file, Result.unwrapOr(Io.read(file), "")))
  }
  var chosen: Array[Mutant] = []
  var index = 0
  for mutant in all {
    if index % (if every > 0 { every } else { 1 }) == 0 { chosen = chosen.push(mutant) }
    index = index + 1
  }
  if Env.hasFlag("--dry-run") {
    for mutant in chosen { let _listed = Io.writeLine(describe(&mutant)) }
    let _counted = Io.writeLine(show(chosen.length()) + " mutants")
    return 0
  }
  let toolchain = Toolchain.locate()
  if toolchain.compiler == None {
    let _said = Io.writeErrorLine("Mutate: pudu was not found; set PUDU_BIN")
    return 1
  }
  var killed = 0
  var survived = 0
  var invalid = 0
  var number = 0
  for mutant in chosen {
    number = number + 1
    match judge(&toolchain, &mutant) {
      case "killed" => { killed = killed + 1 }
      case "survived" => {
        survived = survived + 1
        let _reported = Io.writeLine("survived  " + describe(&mutant))
      }
      case _ => { invalid = invalid + 1 }
    }
    let _progress = Io.writeErrorLine("[" + show(number) + "/" + show(chosen.length()) + "] " + describe(&mutant))
  }
  let scored = killed + survived
  let score = if scored == 0 { 100 } else { killed * 100 / scored }
  let _summary = Io.writeLine("killed " + show(killed) + ", survived " + show(survived) + ", invalid " + show(invalid) + ", score " + show(score) + "%")
  if score < threshold { 1 } else { 0 }
}

/// Applies one mutant, runs the checks, restores the file, and answers the verdict.
fn judge(toolchain: &Toolchain.Toolchain, mutant: &Mutant) -> Str {
  let original = Result.unwrapOr(Io.read(mutant.file), "")
  let _mutated = Io.write(mutant.file, applied(original, mutant))
  let compiled = toolchain.run(["check", mutant.file], "", "", MUTANT_TIMEOUT_MS, RUN_CAP_BYTES)
  let verdict = match compiled {
    case Ok(checked) => {
      if checked.status != 0 {
        "invalid"
      } else {
        match toolchain.run(["test", "test"], "", "", MUTANT_TIMEOUT_MS, RUN_CAP_BYTES) {
          case Ok(tested) => if tested.status == 0 && !tested.timedOut { "survived" } else { "killed" }
          case Err(_) => "invalid"
        }
      }
    }
    case Err(_) => "invalid"
  }
  let _restored = Io.write(mutant.file, original)
  verdict
}

/// Every mutant of one file's text.
fn mutantsOf(file: Str, text: Str) -> Array[Mutant] {
  var found: Array[Mutant] = []
  var lineNumber = 0
  for line in text.split("\n") {
    lineNumber = lineNumber + 1
    let trimmed = line.trim()
    if !trimmed.startsWith("//") && !trimmed.startsWith("/*") {
      let code = codeMask(line)
      for operator in OPERATORS {
        var at = 0
        while at < line.length() {
          if matchesAt(line, &code, at, operator[0]) {
            found = found.push(Mutant{file: file, line: lineNumber, column: at + 1, from: operator[0], to: operator[1]})
          }
          at = at + 1
        }
      }
    }
  }
  found
}

/// Whether an operator occurs at a code position and is not part of a longer operator or word.
fn matchesAt(line: Str, code: &Array[Bool], at: Int, operator: Str) -> Bool {
  let end = at + operator.length()
  if end > line.length() || line.slice(at, end) != operator { return false }
  var position = at
  while position < end {
    if !code[position] { return false }
    position = position + 1
  }
  let before = if at > 0 { line.slice(at - 1, at) } else { "" }
  let after = if end < line.length() { line.slice(end, end + 1) } else { "" }
  if operator == "true" || operator == "false" { return !isWord(before) && !isWord(after) }
  if operator == "<" { return after != "=" && after != "-" && before != "<" }
  if operator == ">" { return after != "=" && before != "-" && before != "=" && before != ">" }
  if operator == "!" { return after != "=" && (isWord(after) || after == "(") }
  if operator == "- 1" || operator == "+ 1" { return !isWord(after) }
  true
}

/// For each character of a line, whether it is code rather than a string literal or comment.
fn codeMask(line: Str) -> Array[Bool] {
  var mask: Array[Bool] = []
  var inString = false
  var escaped = false
  var commented = false
  var index = 0
  let characters = line.chars()
  for character in characters {
    if commented {
      mask = mask.push(false)
    } else if inString {
      mask = mask.push(false)
      if escaped { escaped = false } else if character == '\\' { escaped = true } else if character == '"' { inString = false }
    } else if character == '"' {
      inString = true
      mask = mask.push(false)
    } else if character == '/' && index + 1 < characters.length() && characters[index + 1] == '/' {
      commented = true
      mask = mask.push(false)
    } else if character == '\'' {
      mask = mask.push(false)
    } else {
      mask = mask.push(true)
    }
    index = index + 1
  }
  mask
}

/// The text with one mutant applied.
fn applied(text: Str, mutant: &Mutant) -> Str {
  let lines = text.split("\n")
  let target = lines[mutant.line - 1]
  let start = mutant.column - 1
  let changed = target.slice(0, start) + mutant.to + target.drop(start + mutant.from.length())
  lines.slice(0, mutant.line - 1).concat([changed]).concat(lines.slice(mutant.line, lines.length())).join("\n")
}

/// A mutant as `file:line:column  from → to`.
fn describe(mutant: &Mutant) -> Str {
  mutant.file + ":" + show(mutant.line) + ":" + show(mutant.column) + "  " + mutant.from + " → " + (if mutant.to.isEmpty() { "(removed)" } else { mutant.to })
}

/// Whether text is one identifier character.
fn isWord(text: Str) -> Bool {
  !text.isEmpty() && Text.allChars(text, |c: Char| Char.isAlphanumeric(c) || c == '_')
}

/// Every mutable source file under a directory, sorted.
fn sources(directory: Str) -> Array[Str] {
  var found: Array[Str] = []
  for path in List.sortBy(&Result.unwrapOr(Io.listPaths(directory), []), fn(left: Str, right: Str) -> Bool { left < right }) {
    if path.endsWith(".pudu") {
      if !path.startsWith(GENERATED) && !EXCLUDED.contains(path) { found = found.push(path) }
    } else if !path.contains(".") {
      found = found.concat(sources(path))
    }
  }
  found
}
