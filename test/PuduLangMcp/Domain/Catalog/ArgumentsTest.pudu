/** @Test.Domain.Catalog.ArgumentsTest.Suite — tool argument validation */
module PuduLangMcp.Domain.Catalog.ArgumentsTest

import Std.Io as Io
import Std.Json as Json
import Std.Test as Test
import PuduLangMcp.Domain.Catalog.Arguments as Arguments
import PuduLangMcp.Domain.Catalog.ToolSpec as ToolSpec
import PuduLangMcp.Errors.ToolError as ToolError

/// A spec exercising every rule: a required text, a bounded integer, and an exclusive pair.
fn sample() -> ToolSpec.ToolSpec {
  ToolSpec.ToolSpec {
    name: "sample",
    title: "Sample",
    description: "A tool for tests.",
    properties: [
      ToolSpec.text("query", "What to find.", true),
      ToolSpec.integer("limit", "How many.", false, 1, 10),
      ToolSpec.text("source", "Code.", false),
      ToolSpec.text("path", "A file.", false)
    ],
    exactlyOne: ["source", "path"],
    annotations: ToolSpec.Annotations{readOnly: true, destructive: false, idempotent: true, openWorld: false}
  }
}

/// A spec whose exclusive group has three names.
fn triple() -> ToolSpec.ToolSpec {
  ToolSpec.ToolSpec{..sample(), properties: [ToolSpec.text("a", "A.", false), ToolSpec.text("b", "B.", false), ToolSpec.text("c", "C.", false)], exactlyOne: ["a", "b", "c"]}
}

/// Whether arguments are accepted by the three-way spec.
fn tripleAccepts(members: &Array[(Str, Json.Json)]) -> Bool {
  Arguments.validate(&triple(), &Json.object(members)) != Err(ToolError.ExactlyOne(["a", "b", "c"]))
}

/// The failure validating `members` answers, if any.
fn failureOf(members: &Array[(Str, Json.Json)]) -> Option[ToolError.ToolFailure] {
  match Arguments.validate(&sample(), &Json.object(members)) {
    case Ok(_) => None
    case Err(failure) => Some(failure)
  }
}

/// Runs the suite.
fn main() -> Int {
  let valid = [("query", Json.Text("x")), ("source", Json.Text("module Main"))]
  let accepted = Arguments.validate(&sample(), &Json.object(&valid.push(("limit", Json.Number(3)))))
  let checks = Test.suite("Domain.Catalog.Arguments", &[
      Test.succeeded("valid arguments are accepted", &accepted),
      Test.equals("a text argument is read", &match accepted { case Ok(args) => Arguments.text(&args, "query") case Err(_) => None }, &Some("x")),
      Test.equals("an integer argument is read", &match accepted { case Ok(args) => Arguments.integerOr(&args, "limit", 0) case Err(_) => 0 }, &3),
      Test.equals("an absent integer takes its fallback", &match Arguments.validate(&sample(), &Json.object(&valid)) { case Ok(args) => Arguments.integerOr(&args, "limit", 7) case Err(_) => 0 }, &7),
      Test.equals("null arguments are an empty object", &match Arguments.validate(&sample(), &Json.Null) { case Err(failure) => Some(failure) case Ok(_) => None }, &Some(ToolError.MissingArgument("query"))),
      Test.equals("a non-object is refused", &match Arguments.validate(&sample(), &Json.list(&[])) { case Err(failure) => Some(failure) case Ok(_) => None }, &Some(ToolError.NotAnObject)),
      Test.equals("an undeclared argument is refused", &failureOf(&valid.push(("limt", Json.Number(3)))), &Some(ToolError.UnknownArgument("limt"))),
      Test.equals("a missing required argument is refused", &failureOf(&[("source", Json.Text("m"))]), &Some(ToolError.MissingArgument("query"))),
      Test.equals("a blank required text is refused", &failureOf(&[("query", Json.Text("   ")), ("source", Json.Text("m"))]), &Some(ToolError.WrongType("query", "a non-empty string"))),
      Test.equals("a number for a text is refused", &failureOf(&[("query", Json.Number(1)), ("source", Json.Text("m"))]), &Some(ToolError.WrongType("query", "a string"))),
      Test.equals("text for an integer is refused", &failureOf(&valid.push(("limit", Json.Text("3")))), &Some(ToolError.WrongType("limit", "an integer"))),
      Test.equals("a fraction for an integer is refused", &failureOf(&valid.push(("limit", Json.Fractional("2.5")))), &Some(ToolError.WrongType("limit", "an integer"))),
      Test.equals("null for an argument is the wrong kind", &failureOf(&valid.push(("limit", Json.Null))), &Some(ToolError.WrongType("limit", "an integer"))),
      Test.equals("an integer below its minimum is refused", &failureOf(&valid.push(("limit", Json.Number(0)))), &Some(ToolError.OutOfRange("limit", "between 1 and 10"))),
      Test.equals("an integer above its maximum is refused", &failureOf(&valid.push(("limit", Json.Number(11)))), &Some(ToolError.OutOfRange("limit", "between 1 and 10"))),
      Test.equals("the minimum itself is accepted", &failureOf(&valid.push(("limit", Json.Number(1)))), &None),
      Test.equals("the maximum itself is accepted", &failureOf(&valid.push(("limit", Json.Number(10)))), &None),
      Test.equals("neither of an exclusive pair is refused", &failureOf(&[("query", Json.Text("x"))]), &Some(ToolError.ExactlyOne(["source", "path"]))),
      Test.equals("both of an exclusive pair are refused", &failureOf(&[("query", Json.Text("x")), ("source", Json.Text("m")), ("path", Json.Text("a.pudu"))]), &Some(ToolError.ExactlyOne(["source", "path"]))),
      Test.that("one of three exclusive names is accepted", tripleAccepts(&[("b", Json.Text("x"))])),
      Test.not("two of three exclusive names are refused", tripleAccepts(&[("a", Json.Text("x")), ("c", Json.Text("y"))])),
      Test.not("none of three exclusive names is refused", tripleAccepts(&[])),
      Test.equals("a blank optional text is accepted", &failureOf(&[("query", Json.Text("x")), ("path", Json.Text(""))]), &None)
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
