/** @Test.Domain.Catalog.PromptsTest.Suite — prompt templates and rendering */
module PuduLangMcp.Domain.Catalog.PromptsTest

import Std.Io as Io
import Std.Json as Json
import Std.List as List
import Std.Test as Test
import PuduLangMcp.Constants.Protocol as Protocol
import PuduLangMcp.Domain.Catalog.Prompts as Prompts
import PuduLangMcp.Errors.RpcError as RpcError

/// The user text a prompt renders, or the error code refusing it.
fn rendered(name: Str, arguments: &Array[(Str, Json.Json)]) -> Result[Str, Int] {
  match Prompts.render(name, &Json.object(arguments)) {
    case Ok(held) => Ok(held[1])
    case Err(problem) => Err(RpcError.code(&problem))
  }
}

/// Runs the suite.
fn main() -> Int {
  let names = Prompts.all().map(|spec: Prompts.PromptSpec| spec.name)
  let written = rendered("pudu_write_code", &[("task", Json.Text("parse a CSV line"))])
  let fixing = rendered("pudu_fix_diagnostics", &[("source", Json.Text("module Main")), ("diagnostics", Json.Text("E3001 here"))])
  let unfixed = rendered("pudu_fix_diagnostics", &[("source", Json.Text("module Main"))])
  let checks = Test.suite("Domain.Catalog.Prompts", &[
      Test.equals("names are unique", &List.distinct(&names).length(), &names.length()),
      Test.equals("four prompts are offered", &names.length(), &4),
      Test.that("the task reaches the message", match written { case Ok(text) => text.contains("parse a CSV line") case Err(_) => false }),
      Test.that("every message carries the conventions", match written { case Ok(text) => text.contains(Prompts.CONVENTIONS) case Err(_) => false }),
      Test.that("given diagnostics are quoted", match fixing { case Ok(text) => text.contains("E3001 here") case Err(_) => false }),
      Test.that("absent diagnostics point at pudu_check", match unfixed { case Ok(text) => text.contains("pudu_check") case Err(_) => false }),
      Test.that("the conventions state the interpolation rule", Prompts.CONVENTIONS.contains("\\\{")),
      Test.equals("an unknown prompt is invalid params", &rendered("pudu_nope", &[]), &Err(Protocol.INVALID_PARAMS)),
      Test.equals("a missing required argument is invalid params", &rendered("pudu_review", &[]), &Err(Protocol.INVALID_PARAMS)),
      Test.all("every prompt refuses its missing required arguments", &Prompts.all(), |spec: Prompts.PromptSpec| rendered(spec.name, &[]) == Err(Protocol.INVALID_PARAMS)),
      Test.equals("a fix needs its source", &rendered("pudu_fix_diagnostics", &[("diagnostics", Json.Text("E1"))]), &Err(Protocol.INVALID_PARAMS)),
      Test.equals("a blank required argument is invalid params", &rendered("pudu_review", &[("source", Json.Text(" "))]), &Err(Protocol.INVALID_PARAMS)),
      Test.equals("a non-string argument is invalid params", &rendered("pudu_explain", &[("topic", Json.Number(1))]), &Err(Protocol.INVALID_PARAMS)),
      Test.equals("a listed prompt names its required argument", &Json.path(&Prompts.toJson(&Prompts.all()[0]), &["arguments"]), &Some(Json.list(&[Json.object(&[("name", Json.Text("task")), ("description", Json.Text("What the code should do.")), ("required", Json.Boolean(true))])])))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
