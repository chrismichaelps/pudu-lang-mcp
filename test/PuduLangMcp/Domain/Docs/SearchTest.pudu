/** @Test.Domain.Docs.SearchTest.Suite — documentation ranking */
module PuduLangMcp.Domain.Docs.SearchTest

import Std.Io as Io
import Std.List as List
import Std.Test as Test
import PuduLangMcp.Domain.Docs.Chapter as Chapter
import PuduLangMcp.Domain.Docs.Search as Search
import PuduLangMcp.Generated.Docs as Docs

/// The addresses of the best sections for a query over the corpus.
fn top(sections: &Array[Chapter.Section], query: Str, limit: Int) -> Array[Str] {
  Search.search(sections, query, limit).map(|hit: Search.Hit| hit.section.chapter + "#" + hit.section.anchor)
}

/// Runs the suite.
fn main() -> Int {
  let sections = Chapter.allSections(&Docs.CHAPTERS)
  let heading = Chapter.Section{group: "docs", chapter: "a", chapterTitle: "A", heading: "Traits", anchor: "traits", text: "nothing"}
  let body = Chapter.Section{group: "docs", chapter: "b", chapterTitle: "B", heading: "Other", anchor: "other", text: "traits traits"}
  let traits = Chapter.Section{..heading, text: "x"}
  let six = Chapter.Section{..heading, heading: "Other", text: "zz zz zz zz zz zz"}
  let five = Chapter.Section{..six, text: "zz zz zz zz zz"}
  let four = Chapter.Section{..six, text: "zz zz zz zz"}
  let first = Chapter.Section{..heading, chapter: "first", heading: "Other", text: "qq"}
  let second = Chapter.Section{..first, chapter: "second"}
  let step = Search.score(&five, "zz", &["zz"]) - Search.score(&four, "zz", &["zz"])
  let checks = Test.suite("Domain.Docs.Search", &[
      Test.equals("stop words are dropped and terms kept once", &Search.terms("How do I use the Result and the Result?"), &["result"]),
      Test.equals("a qualified name stays one term", &Search.terms("Option.unwrapOr"), &["option.unwrapor"]),
      Test.equals("trailing dots are not part of a term", &Search.terms("errors."), &["errors"]),
      Test.equals("a query of stop words has no terms", &Search.terms("how do I"), &[]),
      Test.equals("a query of stop words finds nothing", &top(&sections, "what is the", 5), &[]),
      Test.equals("no terms score zero", &Search.score(&heading, "", &[]), &0),
      Test.that("a heading match outranks text matches", Search.score(&heading, "traits", &["traits"]) > Search.score(&body, "traits", &["traits"])),
      Test.equals("a section without the term scores zero", &Search.score(&body, "ownership", &["ownership"]), &0),
      Test.equals("a three-character phrase in a heading earns the phrase points", &Search.score(&traits, "tra", &["tra"]), &65),
      Test.equals("a two-character query is not scored as a phrase", &Search.score(&traits, "tr", &["tr"]), &25),
      Test.equals("a phrase in the text earns its points", &Search.score(&Chapter.Section{..six, text: "abc"}, "abc", &["abc"]), &29),
      Test.equals("occurrences past five stop adding points", &Search.score(&six, "zz", &["zz"]), &Search.score(&five, "zz", &["zz"])),
      Test.equals("each occurrence up to five adds two points", &step, &2),
      Test.equals("a missing term forfeits the every-term points", &Search.score(&four, "zz yy", &["zz", "yy"]), &8),
      Test.equals("equal scores keep corpus order", &Search.search(&[first, second], "qq", 5).map(|hit: Search.Hit| hit.section.chapter), &["first", "second"]),
      Test.equals("only matching sections are answered", &Search.search(&[first, heading], "qq", 50).length(), &1),
      Test.equals("term characters are letters, digits, underscore, and dot", &Search.terms("Zeta9 alpha_beta x.y q@w r[s t`u v\{z k/l m:n"), &["zeta9", "alpha_beta", "x.y", "q", "w", "r", "s", "t", "u", "v", "z", "k", "l", "m", "n"]),
      Test.equals("a limit of zero answers nothing", &top(&sections, "ownership", 0), &[]),
      Test.equals("the limit bounds the answer", &top(&sections, "error", 3).length(), &3),
      Test.that("error handling finds the errors chapter", top(&sections, "error handling with Result", 3).filter(|at: Str| at.startsWith("errors#")).length() > 0),
      Test.that("structured scopes find the concurrency chapter", List.first(&top(&sections, "async scope", 1)) == Some("concurrency#structured-scopes")),
      Test.that("installing a package finds the dependencies chapter", List.first(&top(&sections, "install a package", 1)) == Some("dependencies#installing-a-dependency")),
      Test.that("a search is repeatable", top(&sections, "traits generics", 5) == top(&sections, "traits generics", 5))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
