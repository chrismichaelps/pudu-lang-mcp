/** @Test.Domain.Lsp.RenderTest.Suite — language-server results as text */
module PuduLangMcp.Domain.Lsp.RenderTest

import Std.Io as Io
import Std.Json as Json
import Std.Result as Result
import Std.Test as Test
import PuduLangMcp.Domain.Lsp.Render as Render

/// JSON written as text, decoded.
fn value(text: Str) -> Json.Json {
  Result.unwrapOr(Json.decode(text), Json.Null)
}

/// Shows a URI by its last path segment.
fn shortName(uri: Str) -> Str {
  uri.drop(uri.indexOf("/a/") + 3)
}

/// Runs the suite.
fn main() -> Int {
  let range = "\"range\":\{\"start\":\{\"line\":6,\"character\":10\},\"end\":\{\"line\":6,\"character\":16\}\}"
  let location = value("\{\"uri\":\"file:///a/Sample.pudu\"," + range + "\}")
  let links = value("[\{\"targetUri\":\"file:///a/Other.pudu\",\"targetRange\":\{\"start\":\{\"line\":0,\"character\":0\},\"end\":\{\"line\":2,\"character\":1\}\}\}]")
  let edit = value("\{\"changes\":\{\"file:///a/Sample.pudu\":[\{" + range + ",\"newText\":\"twice\"\}]\}\}")
  let outline = value("[\{\"name\":\"Shape\",\"kind\":23,\"range\":\{\"start\":\{\"line\":1,\"character\":0\},\"end\":\{\"line\":4,\"character\":1\}\},\"children\":[\{\"name\":\"area\",\"kind\":6,\"detail\":\"Int\",\"range\":\{\"start\":\{\"line\":2,\"character\":2\},\"end\":\{\"line\":2,\"character\":9\}\}\}]\}]")
  let signature = value("\{\"signatures\":[\{\"label\":\"double(value: Int) -> Int\",\"documentation\":\{\"kind\":\"markdown\",\"value\":\"Doubles.\"\},\"parameters\":[\{\"label\":[7,17]\}]\}],\"activeSignature\":0,\"activeParameter\":0\}")
  let completion = value("[\{\"label\":\"alpha\",\"detail\":\"Int\"\},\{\"label\":\"beta\"\},\{\"label\":\"gamma\"\}]")
  let diagnostics = [value("\{" + range + ",\"severity\":2,\"code\":\"W3003\",\"message\":\"only propagates\"\}")]
  let checks = Test.suite("Domain.Lsp.Render", &[
      Test.equals("markup hover renders its value", &Render.hover(&value("\{\"contents\":\{\"kind\":\"markdown\",\"value\":\"x : Int\"\}\}")), &"x : Int"),
      Test.equals("a string hover renders as is", &Render.hover(&value("\{\"contents\":\"plain\"\}")), &"plain"),
      Test.equals("a list hover joins its parts", &Render.hover(&value("\{\"contents\":[\"a\",\{\"value\":\"b\"\}]\}")), &"a\n\nb"),
      Test.equals("a null hover says so", &Render.hover(&Json.Null), &"No information at this position."),
      Test.equals("a location renders 1-based", &Render.locations(&location, shortName).map(|held: Render.Location| Render.locationLine(&held)), &["Sample.pudu:7:11"]),
      Test.equals("location links are read", &Render.locations(&links, shortName).map(|held: Render.Location| Render.locationLine(&held)), &["Other.pudu:1:1"]),
      Test.equals("a location keeps its end line", &Render.locations(&links, shortName).map(|held: Render.Location| held.endLine), &[3]),
      Test.equals("null locations are none", &Render.locations(&Json.Null, shortName).length(), &0),
      Test.equals("a rename renders each edit", &Render.workspaceEdit(&edit, shortName), &"Sample.pudu:7:11-7:17 → twice"),
      Test.equals("no edits says so", &Render.workspaceEdit(&value("\{\}"), shortName), &"No edits."),
      Test.equals("an outline indents nested declarations", &Render.documentSymbols(&outline), &"struct Shape (line 2)\n  method area — Int (line 3)"),
      Test.equals("an empty outline says so", &Render.documentSymbols(&value("[]")), &"No declarations."),
      Test.equals("signature help names the active parameter", &Render.signatureHelp(&signature), &"double(value: Int) -> Int\nactive parameter: value: Int\nDoubles."),
      Test.equals("no signature says so", &Render.signatureHelp(&value("\{\"signatures\":[]\}")), &"No signature at this position."),
      Test.equals("completion is bounded with a count of the rest", &Render.completion(&completion, 2), &"alpha — Int\nbeta\n… and 1 more"),
      Test.equals("a completion list object is read", &Render.completion(&value("\{\"items\":[\{\"label\":\"x\"\}]\}"), 5), &"x"),
      Test.equals("no completions says so", &Render.completion(&value("[]"), 5), &"No completions at this position."),
      Test.equals("code actions render their titles and kinds", &Render.codeActions(&value("[\{\"title\":\"Remove import\",\"kind\":\"quickfix\"\}]")), &"Remove import (quickfix)"),
      Test.equals("diagnostics render position, severity, and code", &Render.diagnostics(&diagnostics), &"7:11 warning [W3003] only propagates"),
      Test.equals("workspace symbols render where they are", &Render.workspaceSymbols(&value("[\{\"name\":\"double\",\"kind\":12,\"location\":\{\"uri\":\"file:///a/Sample.pudu\"," + range + "\}\}]"), shortName), &"function double — Sample.pudu:7:11"),
      Test.equals("an unknown symbol kind is a symbol", &Render.documentSymbols(&value("[\{\"name\":\"x\",\"kind\":99\}]")), &"symbol x")
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
