/** @Test.App.ToolsTest.Suite — tool handlers against a recording toolchain */
module App.ToolsTest

import Std.Env as Env
import Std.Fs as Fs
import Std.Io as Io
import Std.Json as Json
import Std.List as List
import Std.Option as Option
import Std.Result as Result
import Std.Sync as Sync
import Std.Test as Test
import App.Context as Context
import App.Tools.Registry as Registry
import Domain.Lsp.Conversation as Conversation
import Generated.Docs as Docs
import Services.Process.Bounded as Bounded
import Services.Toolchain as Toolchain
import Services.Workspace as Workspace
import Utils.JsonAccess as Access

/** @Test.App.ToolsTest.Call — one recorded toolchain call */
type Call = { arguments: Array[Str], input: Str, directory: Str }

/// A language-server transcript answering the question with `result`.
fn transcript(result: Json.Json) -> Str {
  Conversation.frame(&Json.object(&[("jsonrpc", Json.Text("2.0")), ("id", Json.Number(2)), ("result", result)]))
}

/// A toolchain that records every call and answers by command.
fn recording(calls: &Sync.Cell[Array[Call]], library: Str) -> Toolchain.Toolchain {
  let log = *calls
  Toolchain.scripted("0.1.1", Some(library), fn(arguments: Array[Str], input: Str, directory: Str) -> Bounded.Finished {
      let _logged = Sync.set(&log, Result.unwrapOr(Sync.get(&log), []).push(Call{arguments: arguments, input: input, directory: directory}))
      let command = Option.unwrapOr(List.first(&arguments), "")
      if command == "check" { return Toolchain.finished(1, directory + "/Main.pudu:3:1 error[E3001]: expected Int") }
      if command == "fmt" { return if input.isEmpty() && arguments.contains("bad.pudu") { Toolchain.finished(1, "error[E1001]") } else { Toolchain.finished(0, "module Main\n") } }
      if command == "run" { return Bounded.Finished{status: 0, output: "hello", errors: "", timedOut: arguments.contains("Slow.pudu"), truncated: false, millis: 5} }
      if command == "lsp" {
        if input.contains("textDocument/hover") { return Toolchain.finished(0, transcript(Json.object(&[("contents", Json.object(&[("kind", Json.Text("markdown")), ("value", Json.Text("double : fn(Int) -> Int"))]))]))) }
        if input.contains("workspace/symbol") { return Toolchain.finished(0, transcript(Json.list(&[Json.object(&[("name", Json.Text("area")), ("kind", Json.Number(12)), ("location", Json.object(&[("uri", Json.Text("file://" + directory + "/src/Shapes.pudu")), ("range", Json.object(&[("start", Json.object(&[("line", Json.Number(0)), ("character", Json.Number(0))])), ("end", Json.object(&[("line", Json.Number(0)), ("character", Json.Number(4))]))]))]))])]))) }
        if input.contains("textDocument/definition") && input.contains("LIBRARY_TARGET") { return Toolchain.finished(0, transcript(location("file://" + library + "/Std/Io.pudu", 0))) }
        if input.contains("textDocument/definition") && input.contains("OUTSIDE_TARGET") { return Toolchain.finished(0, transcript(location("file:///etc/hosts", 0))) }
        if input.contains("textDocument/definition") && input.contains("FAR_TARGET") { return Toolchain.finished(0, transcript(location("file://" + directory + "/Main.pudu", 400))) }
        if input.contains("textDocument/definition") && input.contains("EXACT_TARGET") { return Toolchain.finished(0, transcript(location("file://" + directory + "/Main.pudu", 3))) }
        if input.contains("textDocument/definition") && input.contains("module Shapes") { return Toolchain.finished(0, transcript(location("file://" + directory + "/src/Shapes.pudu", 0))) }
        if input.contains("textDocument/definition") { return Toolchain.finished(0, transcript(Json.object(&[("uri", Json.Text("file://" + directory + "/Main.pudu")), ("range", Json.object(&[("start", Json.object(&[("line", Json.Number(2)), ("character", Json.Number(3))])), ("end", Json.object(&[("line", Json.Number(2)), ("character", Json.Number(9))]))]))]))) }
        if input.contains("textDocument/references") { return Toolchain.finished(0, Conversation.frame(&Json.object(&[("jsonrpc", Json.Text("2.0")), ("id", Json.Number(2)), ("error", Json.object(&[("code", Json.Number(-32603)), ("message", Json.Text("index not ready"))]))]))) }
        return Toolchain.finished(0, "")
      }
      if command == "api" { return Toolchain.finished(0, "\{\"exports\":[]\}") }
      if command == "doc" { return Toolchain.finished(0, "\{\"entries\":[]\}") }
      Toolchain.finished(0, "ran " + arguments.join(" "))
    })
}

/// A definition result at a 0-based line of a file.
fn location(uri: Str, line: Int) -> Json.Json {
  Json.object(&[("uri", Json.Text(uri)), ("range", Json.object(&[("start", Json.object(&[("line", Json.Number(line)), ("character", Json.Number(0))])), ("end", Json.object(&[("line", Json.Number(line)), ("character", Json.Number(1))]))]))])
}

/// Calls a tool and answers its text and whether it was an error.
fn call(context: &Context.Context, name: Str, arguments: &Array[(Str, Json.Json)]) -> (Str, Bool) {
  match Registry.call(context, &Json.object(&[("name", Json.Text(name)), ("arguments", Json.object(arguments))])) {
    case Ok(result) => {
      let text = match Json.path(&result, &["content"]) {
        case Some(content) => Option.unwrapOr(Option.andThen(Json.at(&content, 0), |block: Json.Json| Access.text(&block, "text")), "")
        case None => ""
      }
      (text, Json.path(&result, &["isError"]) == Some(Json.Boolean(true)))
    }
    case Err(_) => ("protocol error", true)
  }
}

/// The last recorded call.
fn last(calls: &Sync.Cell[Array[Call]]) -> Call {
  Option.unwrapOr(List.last(&Result.unwrapOr(Sync.get(calls), [])), Call{arguments: [], input: "", directory: ""})
}

/// Runs the suite.
fn main() -> Int {
  let temporary = Env.temporaryDirectory()
  let library = Result.unwrapOr(Fs.temporaryDirectoryIn(temporary, "pudu-mcp-lib-"), "/nonexistent")
  let root = Result.unwrapOr(Fs.temporaryDirectoryIn(temporary, "pudu-mcp-ws-"), "/nonexistent")
  let outside = Result.unwrapOr(Fs.temporaryDirectoryIn(temporary, "pudu-mcp-out-"), "/nonexistent")
  let _libraryMade = Io.makeDirectory(library + "/Std")
  let _libraryFile = Io.write(library + "/Std/Io.pudu", "module Std.Io\n\nexport fn read() -> Int \{ 1 \}\n")
  let _sourceMade = Io.makeDirectory(root + "/src")
  let _sourceFile = Io.write(root + "/src/Shapes.pudu", "module Shapes\n")
  let _notes = Io.write(root + "/notes.txt", "plain")
  let _secret = Io.write(outside + "/Secret.pudu", "module Secret\n")
  let _linked = Fs.linkTo(outside + "/Secret.pudu", root + "/src/Escape.pudu")
  let calls = Sync.cell([])
  let context = Context.create(recording(&calls, library), Workspace.at(root), Docs.CHAPTERS, "test")
  let checked = call(&context, "pudu_check", &[("source", Json.Text("module Main\n\nfn main() -> Int \{ \"x\" \}\n"))])
  let checkCall = last(&calls)
  let scratchRemoved = !Io.exists(checkCall.directory)
  let placed = call(&context, "pudu_check", &[("source", Json.Text("module App.Greeting\n"))])
  let placedCall = last(&calls)
  let byPath = call(&context, "pudu_check", &[("path", Json.Text("src/Shapes.pudu"))])
  let byPathCall = last(&calls)
  let traversal = call(&context, "pudu_check", &[("path", Json.Text("../" + Option.unwrapOr(List.last(&outside.split("/")), "") + "/Secret.pudu"))])
  let absolute = call(&context, "pudu_check", &[("path", Json.Text(outside + "/Secret.pudu"))])
  let escaped = call(&context, "pudu_check", &[("path", Json.Text("src/Escape.pudu"))])
  let notSource = call(&context, "pudu_check", &[("path", Json.Text("notes.txt"))])
  let absent = call(&context, "pudu_check", &[("path", Json.Text("src/Nope.pudu"))])
  let both = call(&context, "pudu_check", &[("path", Json.Text("src/Shapes.pudu")), ("source", Json.Text("module Main"))])
  let formatted = call(&context, "pudu_format", &[("source", Json.Text("module Main\n"))])
  let ran = call(&context, "pudu_run", &[("source", Json.Text("module Main\n"))])
  let runCall = last(&calls)
  let slow = call(&context, "pudu_run", &[("source", Json.Text("module Slow\n")), ("timeoutMs", Json.Number(200))])
  let tooLong = call(&context, "pudu_run", &[("source", Json.Text("module Main\n")), ("timeoutMs", Json.Number(3600000))])
  let tested = call(&context, "pudu_test", &[])
  let testCall = last(&calls)
  let testedPath = call(&context, "pudu_test", &[("path", Json.Text("src"))])
  let testPathCall = last(&calls)
  let testedOutside = call(&context, "pudu_test", &[("path", Json.Text(outside))])
  let hovered = call(&context, "pudu_hover", &[("source", Json.Text("module Main\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let defined = call(&context, "pudu_definition", &[("source", Json.Text("module Main\n\nfn double(x: Int) -> Int \{ x * 2 \}\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let refused = call(&context, "pudu_references", &[("source", Json.Text("module Main\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let silent = call(&context, "pudu_completion", &[("source", Json.Text("module Main\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let noLine = call(&context, "pudu_hover", &[("source", Json.Text("module Main\n"))])
  let fromWorkspace = call(&context, "pudu_definition", &[("path", Json.Text("src/Shapes.pudu")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let intoLibrary = call(&context, "pudu_definition", &[("source", Json.Text("module Main\n// LIBRARY_TARGET\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let intoOutside = call(&context, "pudu_definition", &[("source", Json.Text("module Main\n// OUTSIDE_TARGET\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let pastEnd = call(&context, "pudu_definition", &[("source", Json.Text("module Main\n// FAR_TARGET\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let atEnd = call(&context, "pudu_definition", &[("source", Json.Text("module Main\n// EXACT_TARGET\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let noLibrary = Context.create(Toolchain.Toolchain{..recording(&calls, library), library: None}, Workspace.at(root), Docs.CHAPTERS, "test")
  let untrustedWithoutLibrary = call(&noLibrary, "pudu_definition", &[("source", Json.Text("module Main\n// OUTSIDE_TARGET\n")), ("line", Json.Number(1)), ("character", Json.Number(1))])
  let symbols = call(&context, "pudu_workspace_symbols", &[("query", Json.Text("are"))])
  let status = call(&context, "pudu_toolchain", &[])
  let bare = Context.create(Toolchain.Toolchain{compiler: None, library: None, version: "", run: fn(arguments: Array[Str], input: Str, directory: Str, millis: Int, capBytes: Int) -> Result[Bounded.Finished, Str] { Err("pudu was not found") }}, Workspace.at(root), Docs.CHAPTERS, "test")
  let missingCheck = call(&bare, "pudu_check", &[("source", Json.Text("module Main\n"))])
  let missingDocs = call(&bare, "pudu_docs_search", &[("query", Json.Text("ownership"))])
  let missingStatus = call(&bare, "pudu_toolchain", &[])
  let readSection = call(&context, "pudu_docs_read", &[("slug", Json.Text("errors")), ("section", Json.Text("working-with-results"))])
  let readMissing = call(&context, "pudu_docs_read", &[("slug", Json.Text("nope"))])
  let readBadGroup = call(&context, "pudu_docs_read", &[("slug", Json.Text("errors")), ("group", Json.Text("blog"))])
  let readBadSection = call(&context, "pudu_docs_read", &[("slug", Json.Text("errors")), ("section", Json.Text("nowhere"))])
  let example = call(&context, "pudu_docs_read", &[("slug", Json.Text("hello")), ("group", Json.Text("examples"))])
  let unknownModule = call(&context, "pudu_module_reference", &[("module", Json.Text("Io"))])
  let shape = call(&context, "pudu_reference_search", &[("query", Json.Text("Array[a] -> a"))])
  let shapeCall = last(&calls)
  let _cleanRoot = Fs.removeTree(root)
  let _cleanOutside = Fs.removeTree(outside)
  let _cleanLibrary = Fs.removeTree(library)
  let checks = Test.suite("App.Tools", &[
      Test.that("check answers the compiler's diagnostics", checked[0].contains("error[E3001]")),
      Test.not("diagnostics are an answer, not a tool error", checked[1]),
      Test.not("the scratch directory is hidden from output", checked[0].contains(checkCall.directory)),
      Test.equals("inline source is checked as Main.pudu", &checkCall.arguments, &["check", "Main.pudu"]),
      Test.that("the scratch directory is removed afterwards", scratchRemoved),
      Test.equals("inline source is placed at its module's path", &placedCall.arguments, &["check", "App/Greeting.pudu"]),
      Test.equals("a workspace file is checked by its relative path", &byPathCall.arguments, &["check", "src/Shapes.pudu"]),
      Test.not("a workspace file is not given a scratch directory", byPathCall.directory.contains("pudu-mcp-") && !byPathCall.directory.contains("pudu-mcp-ws-")),
      Test.that("a relative path out of the workspace is refused", traversal[1] && traversal[0].contains("inside the workspace")),
      Test.that("an absolute path out of the workspace is refused", absolute[1]),
      Test.that("a link out of the workspace is refused", escaped[1]),
      Test.that("a file that is not Pudu source is refused", notSource[1]),
      Test.that("a missing file is refused", absent[1]),
      Test.that("source and path together are refused", both[1] && both[0].contains("exactly one")),
      Test.equals("format answers the formatted code", &formatted, &("module Main", false)),
      Test.equals("a run is always confined", &List.take(&runCall.arguments, 2), &["run", "--confined"]),
      Test.that("a run answers its exit status and output", ran[0].startsWith("exit status 0") && ran[0].contains("hello")),
      Test.that("a stopped run says so and keeps its output", slow[0].startsWith("Stopped after 200 ms") && slow[0].contains("hello")),
      Test.that("a timeout above the ceiling is refused", tooLong[1] && tooLong[0].contains("timeoutMs")),
      Test.equals("tests run in the workspace root", &(testCall.arguments, testCall.directory), &(["test"], context.workspace.root)),
      Test.not("a test run is not an error", tested[1]),
      Test.equals("a test path is passed relative to the workspace", &testPathCall.arguments, &["test", "src"]),
      Test.that("a test path outside the workspace is refused", testedOutside[1]),
      Test.equals("hover answers the language server's text", &hovered, &("double : fn(Int) -> Int", false)),
      Test.that("a definition in inline source shows the source line", defined[0].startsWith("<source>:3:4") && defined[0].contains("fn double(x: Int)")),
      Test.equals("a language-server error is an answer", &refused, &("The language server answered: index not ready", false)),
      Test.that("a server that ends without answering is a tool error", silent[1] && silent[0].contains("without answering")),
      Test.that("a position question needs its line", noLine[1] && noLine[0].contains("'line'")),
      Test.equals("a workspace definition is shown by its workspace path", &fromWorkspace[0], &"src/Shapes.pudu:1:1\n```pudu\nmodule Shapes\n\n```"),
      Test.that("a library definition shows the library's source", intoLibrary[0].startsWith("Std/Io.pudu:1:1") && intoLibrary[0].contains("export fn read() -> Int")),
      Test.equals("a definition outside the workspace and library shows no source", &intoOutside[0], &"/etc/hosts:1:1"),
      Test.equals("a definition past the end of its file shows no source", &pastEnd[0], &"<source>:401:1"),
      Test.equals("a definition at the end of its file shows no source", &atEnd[0], &"<source>:4:1"),
      Test.equals("without a library an outside definition shows no source", &untrustedWithoutLibrary[0], &"/etc/hosts:1:1"),
      Test.not("the index wait has time before its deadline", Context.indexDeadlineReached(99, 100)),
      Test.that("the index wait expires at and after its deadline", Context.indexDeadlineReached(100, 100) && Context.indexDeadlineReached(101, 100)),
      Test.equals("workspace symbols are shown by workspace path", &symbols, &("function area — src/Shapes.pudu:1:1", false)),
      Test.that("a workspace file's diagnostics keep their path", byPath[0].contains(context.workspace.root)),
      Test.not("a finished command is not reported as stopped", checked[0].startsWith("Stopped")),
      Test.that("status names the compiler version", status[0].contains("pudu 0.1.1")),
      Test.that("without a compiler, check says how to install one", missingCheck[1] && missingCheck[0].contains("pudu-lang.org/download")),
      Test.not("without a compiler, documentation still works", missingDocs[1]),
      Test.that("without a compiler, status reports it missing", missingStatus[0].contains("compiler: not found")),
      Test.that("a section is read by its anchor", readSection[0].startsWith("## Working with results")),
      Test.that("an unknown document lists the known ones", readMissing[1] && readMissing[0].contains("ownership")),
      Test.that("an unknown group is refused", readBadGroup[1] && readBadGroup[0].contains("examples")),
      Test.that("an unknown section lists the anchors", readBadSection[1] && readBadSection[0].contains("working-with-results")),
      Test.that("examples are readable as fenced programs", example[0].contains("```pudu")),
      Test.that("an unknown module suggests near names", unknownModule[1] && unknownModule[0].contains("Std.Io")),
      Test.equals("a type shape goes to the compiler's search", &List.take(&shapeCall.arguments, 2), &["search", "Array[a] -> a"]),
      Test.not("a shape search is not an error", shape[1])
    ])
  let report = Test.run(&checks)
  for failure in Test.failuresOf(&report) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&report)
}
