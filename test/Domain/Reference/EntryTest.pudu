/** @Test.Domain.Reference.EntryTest.Suite — declaration listing and name search */
module Domain.Reference.EntryTest

import Std.Io as Io
import Std.List as List
import Std.Test as Test
import Domain.Reference.Entry as Entry

/// A declaration for tests.
fn entry(moduleName: Str, kind: Str, name: Str, signature: Str, doc: Str) -> Entry.Entry {
  Entry.Entry{moduleName: moduleName, kind: kind, name: name, signature: signature, doc: doc}
}

/// The qualified names of the best matches.
fn found(entries: &Array[Entry.Entry], query: Str, limit: Int) -> Array[Str] {
  Entry.search(entries, query, limit).map(|held: Entry.Found| held.entry.moduleName + "." + held.entry.name)
}

/// Runs the suite.
fn main() -> Int {
  let entries = [
    entry("Std.Result", "fn", "unwrapOr", "Result[T, E] -> T -> T", "The value, or a fallback."),
    entry("Std.Option", "fn", "unwrapOr", "Option[T] -> T -> T", "The value, or a fallback."),
    entry("Std.Option", "fn", "unwrapOrElse", "Option[T] -> fn() -> T -> T", ""),
    entry("Std.Option", "type", "Option", "", "A value that may be absent."),
    entry("Std.Text", "fn", "trimEnd", "Str -> Str", "Text without trailing whitespace."),
    entry("Std.Json", "fn (Json)", "show", "&Json -> Str", "")
  ]
  let checks = Test.suite("Domain.Reference.Entry", &[
      Test.equals("an exact name ranks first, in catalogue order", &found(&entries, "unwrapOr", 2), &["Std.Result.unwrapOr", "Std.Option.unwrapOr"]),
      Test.equals("a qualified name is exact", &found(&entries, "Std.Option.unwrapOr", 1), &["Std.Option.unwrapOr"]),
      Test.equals("a prefix outranks a description", &List.first(&found(&entries, "unwrapOrE", 5)), &Some("Std.Option.unwrapOrElse")),
      Test.equals("search is case-insensitive", &found(&entries, "TRIMEND", 1), &["Std.Text.trimEnd"]),
      Test.equals("a description match is found", &found(&entries, "trailing whitespace", 5), &["Std.Text.trimEnd"]),
      Test.equals("a signature match is found", &found(&entries, "fn() -> T", 5), &["Std.Option.unwrapOrElse"]),
      Test.equals("an empty query finds nothing", &found(&entries, "  ", 5), &[]),
      Test.equals("a zero limit finds nothing", &found(&entries, "unwrapOr", 0), &[]),
      Test.equals("a better match later in the catalogue ranks first", &found(&[entries[4], entries[0]], "unwrapOr", 2), &["Std.Result.unwrapOr"]),
      Test.equals("a stronger rule outranks catalogue order", &found(&[entry("A", "fn", "zzfoo", "", ""), entry("B", "fn", "foo", "", "")], "foo", 2), &["B.foo", "A.zzfoo"]),
      Test.equals("modules are listed once, sorted", &Entry.modules(&entries), &["Std.Json", "Std.Option", "Std.Result", "Std.Text"]),
      Test.equals("a module's entries keep catalogue order", &Entry.ofModule(&entries, "Std.Option").map(|held: Entry.Entry| held.name), &["unwrapOr", "unwrapOrElse", "Option"]),
      Test.equals("an unknown module renders nothing", &Entry.renderModule(&entries, "Std.Nope"), &""),
      Test.that("a module rendering counts its declarations", Entry.renderModule(&entries, "Std.Option").startsWith("module Std.Option — 3 public declarations")),
      Test.equals("a declaration renders its signature and documentation", &Entry.render(&entries[4]), &"fn Std.Text.trimEnd :: Str -> Str\n    Text without trailing whitespace."),
      Test.equals("a type without signature renders its name", &Entry.render(&entries[3]), &"type Std.Option.Option\n    A value that may be absent."),
      Test.that("a method of a type counts as a function", Entry.search(&entries, "show", 1)[0].score > 100)
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
