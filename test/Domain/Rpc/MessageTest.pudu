/** @Test.Domain.Rpc.MessageTest.Suite — JSON-RPC line classification */
module Domain.Rpc.MessageTest

import Std.Io as Io
import Std.Json as Json
import Std.Test as Test
import Constants.Protocol as Protocol
import Domain.Rpc.Message as Message
import Errors.RpcError as RpcError

/// The code a refused line is answered with, or 0 when it is not refused.
fn refusedCode(line: Str) -> Int {
  match Message.parse(line) {
    case Message.Refused(_, problem) => RpcError.code(&problem)
    case _ => 0
  }
}

/// Whether a refused line kept the id it carried.
fn refusedId(line: Str) -> Option[Message.RequestId] {
  match Message.parse(line) {
    case Message.Refused(id, _) => id
    case _ => None
  }
}

/// The kind of message a line is, as a word.
fn kindOf(line: Str) -> Str {
  match Message.parse(line) {
    case Message.Request(_, _, _) => "request"
    case Message.Notification(_, _) => "notification"
    case Message.ClientResponse => "response"
    case Message.Refused(_, _) => "refused"
  }
}

/// The id and method of a request line.
fn requestOf(line: Str) -> Option[(Message.RequestId, Str)] {
  match Message.parse(line) {
    case Message.Request(id, method, _) => Some((id, method))
    case _ => None
  }
}

/// The params a request line was given.
fn paramsOf(line: Str) -> Json.Json {
  match Message.parse(line) {
    case Message.Request(_, _, params) => params
    case Message.Notification(_, params) => params
    case _ => Json.Null
  }
}

/// Runs the suite.
fn main() -> Int {
  let checks = Test.suite("Domain.Rpc.Message", &[
      Test.equals("an integer id request", &requestOf("\{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\"\}"), &Some((Message.NumberId(7), "tools/list"))),
      Test.equals("a string id request", &requestOf("\{\"jsonrpc\":\"2.0\",\"id\":\"a-1\",\"method\":\"x\"\}"), &Some((Message.TextId("a-1"), "x"))),
      Test.equals("id zero is a valid id", &requestOf("\{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"x\"\}"), &Some((Message.NumberId(0), "x"))),
      Test.equals("a negative id is kept", &requestOf("\{\"jsonrpc\":\"2.0\",\"id\":-3,\"method\":\"x\"\}"), &Some((Message.NumberId(-3), "x"))),
      Test.differs("string and integer ids differ", &Message.TextId("1"), &Message.NumberId(1)),
      Test.equals("surrounding whitespace is accepted", &kindOf("  \{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\"\}\r"), &"request"),
      Test.equals("no id is a notification", &kindOf("\{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"\}"), &"notification"),
      Test.equals("a result without method is a client response", &kindOf("\{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\{\}\}"), &"response"),
      Test.equals("an error without method is a client response", &kindOf("\{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":\{\"code\":1,\"message\":\"m\"\}\}"), &"response"),
      Test.equals("text that is not JSON is a parse error", &refusedCode("not json"), &Protocol.PARSE_ERROR),
      Test.equals("an empty line is a parse error", &refusedCode(""), &Protocol.PARSE_ERROR),
      Test.equals("truncated JSON is a parse error", &refusedCode("\{\"jsonrpc\":\"2.0\""), &Protocol.PARSE_ERROR),
      Test.equals("a batch is refused as invalid", &refusedCode("[\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\"\}]"), &Protocol.INVALID_REQUEST),
      Test.equals("a JSON number is not a message", &refusedCode("42"), &Protocol.INVALID_REQUEST),
      Test.equals("a null id is refused", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"x\"\}"), &Protocol.INVALID_REQUEST),
      Test.equals("a fractional id is refused", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":1.5,\"method\":\"x\"\}"), &Protocol.INVALID_REQUEST),
      Test.equals("a boolean id is refused", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":true,\"method\":\"x\"\}"), &Protocol.INVALID_REQUEST),
      Test.equals("a missing jsonrpc member is refused", &refusedCode("\{\"id\":1,\"method\":\"x\"\}"), &Protocol.INVALID_REQUEST),
      Test.equals("jsonrpc 1.0 is refused", &refusedCode("\{\"jsonrpc\":\"1.0\",\"id\":1,\"method\":\"x\"\}"), &Protocol.INVALID_REQUEST),
      Test.equals("a refused envelope keeps its id", &refusedId("\{\"jsonrpc\":\"1.0\",\"id\":9,\"method\":\"x\"\}"), &Some(Message.NumberId(9))),
      Test.equals("a non-string method is refused", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":5\}"), &Protocol.INVALID_REQUEST),
      Test.equals("a missing method is refused", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":1\}"), &Protocol.INVALID_REQUEST),
      Test.equals("array params on a request are invalid params", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\",\"params\":[1]\}"), &Protocol.INVALID_PARAMS),
      Test.equals("null params on a request are invalid params", &refusedCode("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\",\"params\":null\}"), &Protocol.INVALID_PARAMS),
      Test.equals("array params on a notification leave it a notification", &kindOf("\{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"params\":[1]\}"), &"notification"),
      Test.equals("absent params are an empty object", &paramsOf("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\"\}"), &Json.object(&[])),
      Test.equals("object params are kept", &paramsOf("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\",\"params\":\{\"a\":1\}\}"), &Json.object(&[("a", Json.Number(1))])),
      Test.equals("a unicode method name is kept", &requestOf("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"añadir\"\}"), &Some((Message.NumberId(1), "añadir"))),
      Test.equals("an integer id encodes as a number", &Message.idJson(&Message.NumberId(5)), &Json.Number(5)),
      Test.equals("a string id encodes as text", &Message.idJson(&Message.TextId("q")), &Json.Text("q"))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
