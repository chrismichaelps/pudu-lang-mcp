/** @Test.Domain.Docs.ChapterTest.Suite — sectioning, anchors, and the corpus */
module Domain.Docs.ChapterTest

import Std.Io as Io
import Std.List as List
import Std.Option as Option
import Std.Test as Test
import Domain.Docs.Chapter as Chapter
import Generated.Docs as Docs

/// A document for tests, in the docs group.
fn document(markdown: Str) -> Chapter.Chapter {
  Chapter.Chapter{group: "docs", slug: "sample", title: "Sample", markdown: markdown}
}

/// Runs the suite.
fn main() -> Int {
  let sample = document("# Sample\n\nIntro text.\n\n## First part\n\nOne.\n\n```pudu\n## not a heading\n```\n\n## Second: part two!\n\nTwo.")
  let sections = Chapter.sectionsOf(&sample)
  let headings = sections.map(|held: Chapter.Section| held.heading)
  let flat = Chapter.sectionsOf(&document("# Sample\n\nOnly text."))
  let noIntro = Chapter.sectionsOf(&document("## Only\n\nText.")).map(|held: Chapter.Section| held.heading)
  let empty = Chapter.sectionsOf(&document("# Sample\n\n## Empty\n## Next\n\nText.")).map(|held: Chapter.Section| held.heading)
  let contents = Chapter.tableOfContents(&[document("# Sample\n\nIntro.\n\n## Part\n\nText.")])
  let groups = List.distinct(&Docs.CHAPTERS.map(|held: Chapter.Chapter| held.group))
  let checks = Test.suite("Domain.Docs.Chapter", &[
      Test.equals("text before the first heading is the introduction", &headings, &["Sample", "First part", "Second: part two!"]),
      Test.that("a heading inside a code fence stays in its section", Option.unwrapOr(List.get(&sections, 1), sections[0]).text.contains("## not a heading")),
      Test.equals("sections carry their document", &sections.map(|held: Chapter.Section| held.chapter), &["sample", "sample", "sample"]),
      Test.equals("a document with no heading is one section", &flat.length(), &1),
      Test.equals("an anchor joins lowercase words with dashes", &Chapter.anchorOf("Second: part two!"), &"second-part-two"),
      Test.equals("an anchor of punctuation alone is empty", &Chapter.anchorOf("?!"), &""),
      Test.equals("a document that starts with a section has no introduction", &noIntro, &["Only"]),
      Test.equals("a heading with no text is still a section", &empty, &["Empty", "Next"]),
      Test.equals("the contents list sections beneath their document only", &contents, &"docs/sample — Sample\n  Part (#part)"),
      Test.equals("an anchor keeps the ends of the letter and digit ranges", &Chapter.anchorOf("a z 0 9 `x\{ /y: @w[ _v"), &"a-z-0-9-x-y-w-v"),
      Test.equals("leading and trailing punctuation leaves no dash", &Chapter.anchorOf("-- Title --"), &"title"),
      Test.equals("digits stay in an anchor", &Chapter.anchorOf("HTTP/2 and TLS 1.3"), &"http-2-and-tls-1-3"),
      Test.present("a section is found by its anchor", &Chapter.sectionIn(&sample, "first-part")),
      Test.present("a section is found by its heading in any case", &Chapter.sectionIn(&sample, "FIRST PART")),
      Test.absent("an unknown section is not found", &Chapter.sectionIn(&sample, "third")),
      Test.present("a document is found by group and slug", &Chapter.find(&Docs.CHAPTERS, "docs", "errors")),
      Test.absent("the right slug in the wrong group is not found", &Chapter.find(&Docs.CHAPTERS, "pages", "errors")),
      Test.equals("the corpus holds every published group", &List.sorted(&groups), &["docs", "examples", "pages", "releases"]),
      Test.equals("the language guide has its chapters", &Chapter.inGroup(&Docs.CHAPTERS, "docs").length(), &24),
      Test.that("every document has a title", Docs.CHAPTERS.filter(|held: Chapter.Chapter| held.title.isEmpty()).isEmpty()),
      Test.that("the contents list every document", Chapter.tableOfContents(&Docs.CHAPTERS).contains("releases/0.1.1")),
      Test.that("the corpus keeps literal braces", Option.unwrapOr(Chapter.find(&Docs.CHAPTERS, "docs", "text"), sample).markdown.contains("\{"))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
