/** @Test.Domain.Code.SourceFileTest.Suite — module names and their paths */
module Domain.Code.SourceFileTest

import Std.Io as Io
import Std.Test as Test
import Domain.Code.SourceFile as SourceFile

/// Runs the suite.
fn main() -> Int {
  let checks = Test.suite("Domain.Code.SourceFile", &[
      Test.equals("a module declaration is read", &SourceFile.moduleNameOf("module App.Greeting\n\nfn f() -> Int { 1 }"), &Some("App.Greeting")),
      Test.equals("comments before the declaration are skipped", &SourceFile.moduleNameOf("// note\n/** @A.B.C — header */\n\nmodule Main"), &Some("Main")),
      Test.equals("code before any declaration means none", &SourceFile.moduleNameOf("fn main() -> Int { 0 }\nmodule Main"), &None),
      Test.equals("empty source declares nothing", &SourceFile.moduleNameOf(""), &None),
      Test.equals("an invalid name is not a declaration", &SourceFile.moduleNameOf("module ../../etc"), &None),
      Test.equals("a module's file follows its dots", &SourceFile.fileOf("App.Greeting"), &"App/Greeting.pudu"),
      Test.equals("a file's module follows its slashes", &SourceFile.moduleOfFile("Std/Http/Server.pudu"), &Some("Std.Http.Server")),
      Test.equals("a non-Pudu file is no module", &SourceFile.moduleOfFile("README.md"), &None),
      Test.equals("a path with a dot segment is no module", &SourceFile.moduleOfFile("../Std/Io.pudu"), &None),
      Test.that("underscores and digits are allowed after the first letter", SourceFile.isModuleName("Http2.Server_v1")),
      Test.not("a segment may not start with a digit", SourceFile.isModuleName("2fa.Codes")),
      Test.not("an empty segment is refused", SourceFile.isModuleName("A..B")),
      Test.not("an empty name is refused", SourceFile.isModuleName("")),
      Test.equals("an unterminated block comment is not a comment", &SourceFile.moduleNameOf("/* note\nmodule Main"), &None),
      Test.that("the letters and digits at each end of their ranges are accepted", SourceFile.isModuleName("Az.Za.a09.z9_")),
      Test.all("the characters beside those ranges are refused", &["A@", "A[", "A`", "A\{", "A/", "A:", "@A", "[A", "`A", "\{A"], |name: Str| !SourceFile.isModuleName(name)),
      Test.all("a segment may not start with any digit", &["0a", "9a"], |name: Str| !SourceFile.isModuleName(name))
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
