/** @Test.Errors.ErrorsTest.Suite — protocol codes and tool failure messages */
module Errors.ErrorsTest

import Std.Io as Io
import Std.Json as Json
import Std.Test as Test
import Constants.Protocol as Protocol
import Errors.RpcError as RpcError
import Errors.ToolError as ToolError

/// Runs the suite.
fn main() -> Int {
  let problems = [RpcError.ParseError("x"), RpcError.InvalidRequest("x"), RpcError.MethodNotFound("x"), RpcError.InvalidParams("x"), RpcError.ResourceNotFound("x"), RpcError.UnsupportedVersion("x"), RpcError.Internal("x")]
  let codes = problems.map(|held: RpcError.ProtocolError| RpcError.code(&held))
  let checks = Test.suite("Errors", &[
      Test.equals("codes follow JSON-RPC and MCP", &codes, &[-32700, -32600, -32601, -32602, -32602, -32022, -32603]),
      Test.all("no code is in the legacy sub-range", &codes, |code: Int| code > -32000 || code < -32019),
      Test.equals("a method error names the method", &RpcError.message(&RpcError.MethodNotFound("tools/x")), &"Method not found: tools/x"),
      Test.equals("only two refusals carry data", &problems.filter(|held: RpcError.ProtocolError| RpcError.data(&held) != None).length(), &2),
      Test.equals("an unsupported version lists every supported one", &Json.path(&match RpcError.data(&RpcError.UnsupportedVersion("x")) { case Some(data) => data case None => Json.Null }, &["supported"]), &Some(Json.list(&Protocol.supportedVersions().map(|v: Str| Json.Text(v))))),
      Test.that("a missing toolchain says where to get one", ToolError.explain(&ToolError.ToolchainMissing).contains("pudu-lang.org/download")),
      Test.equals("an exclusive pair names both", &ToolError.explain(&ToolError.ExactlyOne(["source", "path"])), &"Give exactly one of 'source' or 'path'."),
      Test.equals("a timeout names its command and budget", &ToolError.explain(&ToolError.TimedOut("pudu run", 500)), &"'pudu run' did not finish within 500 ms and was stopped."),
      Test.equals("an unavailable feature says why, verbatim", &ToolError.explain(&ToolError.Unavailable("because")), &"because")
    ])
  let ran = Test.run(&checks)
  for failure in Test.failuresOf(&ran) {
    let _reported = Io.writeErrorLine(failure)
  }
  Test.report(&ran)
}
